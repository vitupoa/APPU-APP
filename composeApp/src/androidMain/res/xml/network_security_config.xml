<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Railway backend domain pinning -->
    <!-- Railway backend domain routing -> Pinning temporarily disabled for local compilation -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">krieta-api.up.railway.app</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- For local Android emulator testing -->
    </domain-config>
</network-security-config>

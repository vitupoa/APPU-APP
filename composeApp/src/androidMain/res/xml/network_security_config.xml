<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Railway backend domain pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">krieta-api.up.railway.app</domain>
        <pin-set>
            <!-- Pin will be updated with actual Railway SSL certificate pins -->
            <!-- Use backup pins to handle certificate rotation -->
            <pin digest="SHA-256">PLACEHOLDER_PIN_1=</pin>
            <pin digest="SHA-256">PLACEHOLDER_PIN_2=</pin>
        </pin-set>
    </domain-config>
</network-security-config>

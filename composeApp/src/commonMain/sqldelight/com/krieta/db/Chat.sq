-- Conversation table for offline caching
CREATE TABLE IF NOT EXISTS Conversation (
    id TEXT PRIMARY KEY NOT NULL,
    otherUserId TEXT NOT NULL,
    otherUsername TEXT NOT NULL,
    otherDisplayName TEXT NOT NULL,
    otherAvatarUrl TEXT,
    lastMessageContent TEXT,
    lastMessageSenderId TEXT,
    lastMessageTimestamp TEXT,
    unreadCount INTEGER NOT NULL DEFAULT 0,
    isOnline INTEGER AS Boolean NOT NULL DEFAULT 0,
    updatedAt TEXT NOT NULL,
    cachedAt INTEGER NOT NULL
);

-- Message table for offline caching
CREATE TABLE IF NOT EXISTS Message (
    id TEXT PRIMARY KEY NOT NULL,
    conversationId TEXT NOT NULL,
    senderId TEXT NOT NULL,
    senderUsername TEXT NOT NULL,
    senderDisplayName TEXT NOT NULL,
    senderAvatarUrl TEXT,
    content TEXT NOT NULL,
    messageType TEXT NOT NULL DEFAULT 'TEXT',
    mediaUrl TEXT,
    isRead INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL,
    cachedAt INTEGER NOT NULL,
    FOREIGN KEY (conversationId) REFERENCES Conversation(id) ON DELETE CASCADE
);

-- Queries for Conversation
insertOrReplaceConversation:
INSERT OR REPLACE INTO Conversation (
    id, otherUserId, otherUsername, otherDisplayName, otherAvatarUrl,
    lastMessageContent, lastMessageSenderId, lastMessageTimestamp,
    unreadCount, isOnline, updatedAt, cachedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllConversations:
SELECT * FROM Conversation ORDER BY updatedAt DESC;

getConversationById:
SELECT * FROM Conversation WHERE id = ?;

deleteConversation:
DELETE FROM Conversation WHERE id = ?;

deleteAllConversations:
DELETE FROM Conversation;

updateConversationUnreadCount:
UPDATE Conversation SET unreadCount = ? WHERE id = ?;

-- Queries for Message
insertOrReplaceMessage:
INSERT OR REPLACE INTO Message (
    id, conversationId, senderId, senderUsername, senderDisplayName,
    senderAvatarUrl, content, messageType, mediaUrl, isRead, createdAt, cachedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getMessagesByConversationId:
SELECT * FROM Message WHERE conversationId = ? ORDER BY createdAt ASC;

getLatestMessagesByConversationId:
SELECT * FROM Message WHERE conversationId = ? ORDER BY createdAt DESC LIMIT ?;

deleteMessage:
DELETE FROM Message WHERE id = ?;

deleteMessagesByConversationId:
DELETE FROM Message WHERE conversationId = ?;

markMessagesAsRead:
UPDATE Message SET isRead = 1 WHERE conversationId = ? AND isRead = 0;

-- OfflineAction table for queuing actions when offline
CREATE TABLE IF NOT EXISTS OfflineAction (
    id TEXT PRIMARY KEY NOT NULL,
    actionType TEXT NOT NULL,
    entityType TEXT NOT NULL,
    entityId TEXT NOT NULL,
    payload TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    retryCount INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'PENDING'
);

-- Queries for OfflineAction
insertAction:
INSERT INTO OfflineAction (id, actionType, entityType, entityId, payload, createdAt, retryCount, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getPendingActions:
SELECT * FROM OfflineAction WHERE status = 'PENDING' ORDER BY createdAt ASC;

getActionById:
SELECT * FROM OfflineAction WHERE id = ?;

updateActionStatus:
UPDATE OfflineAction SET status = ?, retryCount = ? WHERE id = ?;

deleteAction:
DELETE FROM OfflineAction WHERE id = ?;

deleteCompletedActions:
DELETE FROM OfflineAction WHERE status = 'COMPLETED';

deleteFailedActions:
DELETE FROM OfflineAction WHERE status = 'FAILED' AND retryCount >= 3;

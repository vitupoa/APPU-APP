// SPONSORED CONTENT / NATIVE ADS MODELS
// Add these models to your main schema.prisma file
// ═══════════════════════════════════════════════════════════

enum SponsoredContentStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum PricingModel {
  CPM  // Cost per 1000 impressions
  CPV  // Cost per view (3+ seconds)
  CPE  // Cost per engagement (like/comment/share)
  CPC  // Cost per click
}

model SponsoredContent {
  id            String                  @id @default(uuid())
  brandUserId   String                  @map("brand_user_id")
  contentType   String                  @map("content_type") // short, post
  contentId     String                  @map("content_id")
  campaignName  String                  @map("campaign_name")
  
  // Budget & Pricing
  budget        Decimal                 @db.Decimal(18, 4)
  spent         Decimal                 @default(0) @db.Decimal(18, 4)
  pricingModel  PricingModel            @map("pricing_model")
  bidAmount     Decimal                 @map("bid_amount") @db.Decimal(18, 4)
  
  // Targeting
  targeting     Json?                   // { ageMin, ageMax, gender[], countries[], interests[] }
  
  // Schedule
  startDate     DateTime                @map("start_date")
  endDate       DateTime                @map("end_date")
  
  // Metrics
  impressions   Int                     @default(0)
  views         Int                     @default(0)
  engagements   Int                     @default(0)
  clicks        Int                     @default(0)
  
  // Status
  status        SponsoredContentStatus  @default(PENDING_REVIEW)
  escrowId      String?                 @map("escrow_id")
  
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  brand         User                    @relation("SponsoredContentBrand", fields: [brandUserId], references: [id], onDelete: Cascade)
  short         Short?                  @relation("SponsoredShort", fields: [contentId], references: [id], onDelete: Cascade)
  post          Post?                   @relation("SponsoredPost", fields: [contentId], references: [id], onDelete: Cascade)
  impressionLog SponsoredImpression[]

  @@index([brandUserId, status])
  @@index([status, startDate, endDate])
  @@index([contentType, contentId])
  @@map("sponsored_content")
}

model SponsoredImpression {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  userId      String   @map("user_id")
  type        String   // impression, view, like, comment, share, click
  cost        Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  campaign SponsoredContent @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
  @@index([userId, createdAt])
  @@map("sponsored_impressions")
}


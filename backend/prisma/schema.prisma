generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  
}

datasource db {
  provider = "postgresql"
}

// ─── USERS ────────────────────────────────────────────────

enum AccountType {
  CREATOR
  BUSINESS
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  username        String      @unique
  firstName       String      @map("first_name")
  lastName        String      @map("last_name")
  displayName     String      @map("display_name")
  avatarUrl       String?     @map("avatar_url")
  coverPhotoUrl   String?     @map("cover_photo_url")
  bio             String?
  country         String      @db.VarChar(2) // ISO country code
  currency        String      @db.VarChar(3) // ISO currency code
  googleId        String?     @unique @map("google_id")
  appleId         String?     @unique @map("apple_id")
  accountType     AccountType @default(CREATOR) @map("account_type")
  isAdmin         Boolean     @default(false) @map("is_admin") 
  isVerified      Boolean     @default(false) @map("is_verified")
  
  // Wallet Security 
  isWalletUnlocked Boolean    @default(false) @map("is_wallet_unlocked")
  walletPinHash   String?     @map("wallet_pin_hash")
  
  passwordHash    String?     @map("password_hash")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  wallet              Wallet?
  refreshTokens       RefreshToken[]
  bioLinks            BioLink[]
  admirers            Admire[]          @relation("AdmiredBy")
  admiring            Admire[]          @relation("Admirer")
  subscriptionTiers   SubscriptionTier[]
  subscribedTo        Subscription[]    @relation("Subscriber")
  subscribers         Subscription[]    @relation("Creator")
  milestoneCompletions MilestoneCompletion[]
  shorts              Short[]
  shortLikes          ShortLike[]
  shortComments       ShortComment[]
  shortCollections    ShortCollection[]
  posts               Post[]
  postLikes           PostLike[]
  postComments        PostComment[]
  contestsCreated     Contest[]
  contestParticipations ContestParticipant[]
  contestSubmissions  ContestSubmission[]
  contestWins         ContestWinner[]
  contestJudges       ContestJudge[]
  contestVotes        ContestVote[]
  transactions        Transaction[]
  escrows             Escrow[]
  products            Product[]
  dailyStats          DailyStat[]
  comments            Comment[]         @relation("CommentAuthor")
  commentLikes        CommentLike[]     @relation("CommentLikes")
  commentReports      CommentReport[]   @relation("CommentReports")
  commentRepliesTo    Comment[]         @relation("CommentReplyTo")
  teamsLed            Team[]            @relation("TeamLeader")
  teamMemberships     TeamMember[]      @relation("TeamMemberships")
  teamInvitationsSent TeamInvitation[]  @relation("TeamInvitationsSent")
  teamInvitationsReceived TeamInvitation[] @relation("TeamInvitationsReceived")
  teamSubmissionVotes TeamSubmissionVote[] @relation("TeamSubmissionVotes")
  judgeInvites        JudgeInvite[]     @relation("JudgeInvites")
  chatParticipations  ChatParticipant[] @relation("ChatParticipations")
  sentMessages        Message[]         @relation("SentMessages")
  stories             Story[]
  storyViews          StoryView[]
  storyViewerPreferences StoryViewerPreference[] @relation("ViewerPreferences")
  preferredStoryViewers  StoryViewerPreference[] @relation("PreferredViewers")
  chamasCreated         Chama[]           @relation("ChamaCreator")
  chamaMemberships      ChamaMember[]     @relation("ChamaMemberships")
  chamaContributions    ChamaContribution[] @relation("ChamaContributions")
  chamaPayoutsReceived  ChamaPayout[]     @relation("ChamaPayoutRecipient")
  chamaPayoutApprovals  ChamaPayoutApproval[] @relation("ChamaPayoutApprovals")
  chamaTransactions     ChamaTransaction[] @relation("ChamaTransactions")
  chamaDefaults         ChamaDefaulter[]  @relation("ChamaDefaults")
  chamaNominations      ChamaNomination[] @relation("ChamaNominations")
  chamaNominated        ChamaNomination[] @relation("ChamaNominees")
  chamaSeconds          ChamaSecondment[] @relation("ChamaSecondments")
  chamaVotes            ChamaVote[]       @relation("ChamaVotes")
  isRotationLocked      Boolean           @default(false) @map("is_rotation_locked")
  fcmToken              String?           @map("fcm_token")
  devicePlatform        String?           @map("device_platform")


  // Shop Marketplace
  productReviews        ProductReview[]
  wishlists             Wishlist[]
  cartItems             CartItem[]
  buyerOrders           Order[]           @relation("BuyerOrders")
  garageProfile         GarageProfile?
  garageBookings        GarageBooking[]   @relation("GarageBooker")
  garageReviews         GarageReview[]    @relation("GarageReviewer")
  importerProfile       ImporterProfile?
  importRequests        ImportRequest[]   @relation("ImportRequester")
  giftsSent             Gift[]            @relation("GiftSender")
  giftsReceived         Gift[]            @relation("GiftRecipient")
  dealAlerts            DealAlert[]
  liveStreamsHosted      LiveStream[]      @relation("LiveHost")
  groupBuyParts         GroupBuyParticipant[]
  productShares         ProductShare[]
  logisticsCompany      LogisticsCompany?
  calls                 Call[]
  shippingJobs          ShippingJob[]     @relation("ShippingRequester")
  vehicleFavorites      VehicleFavorite[]

  // Brand Marketplace Relations
  influencerProfile     InfluencerProfile?
  brandCampaigns        BrandCampaign[]        @relation("BrandCampaigns")
  contestSponsorships   ContestSponsorship[]   @relation("ContestSponsorships")
  conversionCampaigns   ConversionCampaign[]   @relation("ConversionCampaigns")
  conversionRecipients  ConversionCampaignRecipient[] @relation("ConversionRecipients")
  engagementActions     ContestEngagementAction[] @relation("ContestEngagementActions")
  purchaseEntries       ContestPurchaseEntry[] @relation("ContestPurchaseEntries")
  funnelEvents          SalesFunnelEvent[]     @relation("SalesFunnelEvents")
  gamificationPoints    GamificationPoints?
  gamificationActivities GamificationActivity[] @relation("GamificationActivities")
  liveSessions          LiveSession[]          @relation("LiveSessionHost")
  sponsoredCampaigns    SponsoredContent[]     @relation("SponsoredContentBrand")

  // RembrandtRAR (Platform Governance)
  adminProfile          AdminProfile?
  suspensions           UserSuspension[]
  withdrawalRequests    WithdrawalRequest[]
  isSuspended           Boolean           @default(false) @map("is_suspended")
  suspendedAt           DateTime?         @map("suspended_at")

  @@map("users")
}

// ─── AUTH ──────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  deviceId  String   @map("device_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── WALLET ───────────────────────────────────────────────

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  krBalance Decimal  @default(0) @map("kr_balance") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  type           String   // topup, withdraw, tip_sent, tip_received, contest_escrow, contest_prize, subscription_earned, subscription_paid, shop_sale, ad_revenue, platform_fee
  amountKr       Decimal  @map("amount_kr") @db.Decimal(18, 4)
  amountFiat     Decimal? @map("amount_fiat") @db.Decimal(18, 4)
  currency       String?  @db.VarChar(3)
  provider       String?  // paypal, paystack, mpesa, payoneer, platform
  status         String   @default("pending") // pending, completed, failed, cancelled
  reference      String?
  counterpartyId String?  @map("counterparty_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("transactions")
}

model Escrow {
  id            String   @id @default(uuid())
  contestId     String   @map("contest_id")
  userId        String   @map("user_id")
  prizeAmountKr Decimal  @map("prize_amount_kr") @db.Decimal(18, 4)
  feeAmountKr   Decimal  @map("fee_amount_kr") @db.Decimal(18, 4)
  status        String   @default("held") // held, released, refunded
  createdAt     DateTime @default(now()) @map("created_at")

  contest Contest @relation(fields: [contestId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("escrows")
}

// ─── SOCIAL ───────────────────────────────────────────────

model Admire {
  id        String   @id @default(uuid())
  admirerId String   @map("admirer_id")
  admiredId String   @map("admired_id")
  isLovers  Boolean  @default(false) @map("is_lovers")
  createdAt DateTime @default(now()) @map("created_at")

  admirer User @relation("Admirer", fields: [admirerId], references: [id], onDelete: Cascade)
  admired User @relation("AdmiredBy", fields: [admiredId], references: [id], onDelete: Cascade)

  @@unique([admirerId, admiredId])
  @@map("admires")
}

model BioLink {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  label     String
  url       String
  icon      String?
  sortOrder Int    @default(0) @map("sort_order")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bio_links")
}

// ─── SUBSCRIPTIONS ────────────────────────────────────────

enum SubscriptionTierType {
  TOP_FUN
  REAL_FAN
  TRUE_FAN
  SUPER_FAN
}

model SubscriptionTier {
  id        String               @id @default(uuid())
  creatorId String               @map("creator_id")
  tier      SubscriptionTierType
  krAmount  Decimal              @map("kr_amount") @db.Decimal(18, 4)
  benefits  String
  isEnabled Boolean              @default(true) @map("is_enabled")
  createdAt DateTime             @default(now()) @map("created_at")

  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([creatorId, tier])
  @@map("subscription_tiers")
}

model Subscription {
  id            String               @id @default(uuid())
  subscriberId  String               @map("subscriber_id")
  creatorId     String               @map("creator_id")
  tierId        String               @map("tier_id")
  tier          SubscriptionTierType
  krAmount      Decimal              @map("kr_amount") @db.Decimal(18, 4)
  status        String               @default("active") // active, cancelled, expired
  startedAt     DateTime             @default(now()) @map("started_at")
  nextBillingAt DateTime?            @map("next_billing_at")
  cancelledAt   DateTime?            @map("cancelled_at")

  subscriber     User             @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator        User             @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptionTier SubscriptionTier @relation(fields: [tierId], references: [id])

  @@unique([subscriberId, creatorId])
  @@map("subscriptions")
}

// ─── MILESTONES ───────────────────────────────────────────

model Milestone {
  id               String   @id @default(uuid())
  title            String
  description      String
  requirementType  String   @map("requirement_type")
  requirementValue Int      @map("requirement_value")
  rewardKr         Decimal  @map("reward_kr") @db.Decimal(18, 4)
  contestId        String?  @map("contest_id") // Optional link bridging Contest Airdrop FOMO natively
  createdAt        DateTime @default(now()) @map("created_at")

  completions MilestoneCompletion[]
  contest     Contest?              @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model MilestoneCompletion {
  id          String   @id @default(uuid())
  milestoneId String   @map("milestone_id")
  userId      String   @map("user_id")
  completedAt DateTime @default(now()) @map("completed_at")

  milestone Milestone @relation(fields: [milestoneId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([milestoneId]) // Only first user can complete
  @@map("milestone_completions")
}

// ─── SHORTS ───────────────────────────────────────────────

model Short {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  videoUrl        String   @map("video_url")
  thumbnailUrl    String?  @map("thumbnail_url")
  caption         String?
  musicTitle      String?  @map("music_title")
  musicArtist     String?  @map("music_artist")
  isLocked        Boolean  @default(false) @map("is_locked")
  requiredTier    SubscriptionTierType? @map("required_tier")
  contestId       String?  @map("contest_id")
  collectionId    String?  @map("collection_id")
  linkedProductId String?  @map("linked_product_id") // Shop product shown briefly during playback
  views           Int      @default(0)
  likesCount      Int      @default(0) @map("likes_count")
  commentsCount   Int      @default(0) @map("comments_count")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest       Contest?         @relation(fields: [contestId], references: [id])
  collection    ShortCollection? @relation(fields: [collectionId], references: [id])
  linkedProduct Product?         @relation(fields: [linkedProductId], references: [id])
  likes         ShortLike[]
  comments      ShortComment[]
  sponsoredCampaigns SponsoredContent[] @relation("SponsoredShort")

  @@index([userId, createdAt])
  @@map("shorts")
}

model ShortCollection {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  coverUrl  String?  @map("cover_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shorts Short[]

  @@map("short_collections")
}

model ShortLike {
  id        String   @id @default(uuid())
  shortId   String   @map("short_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  short Short @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shortId, userId])
  @@map("short_likes")
}

model ShortComment {
  id        String   @id @default(uuid())
  shortId   String   @map("short_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  short Short @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("short_comments")
}

// ─── FEED POSTS ───────────────────────────────────────────

model Post {
  id            String               @id @default(uuid())
  userId        String               @map("user_id")
  caption       String?
  imageUrls     String[]             @map("image_urls")
  isLocked      Boolean              @default(false) @map("is_locked")
  requiredTier  SubscriptionTierType? @map("required_tier")
  likesCount    Int                  @default(0) @map("likes_count")
  commentsCount Int                  @default(0) @map("comments_count")
  createdAt     DateTime             @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]
  sponsoredCampaigns SponsoredContent[] @relation("SponsoredPost")

  @@index([userId, createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("post_comments")
}

// ─── CONTESTS (CORE) ──────────────────────────────────────

enum ContestMediaType {
  PHOTO
  VIDEO
  PHOTO_AND_VIDEO
}

enum ContestStatus {
  DRAFT
  ACTIVE
  JUDGING
  PENDING_PAYOUT
  COMPLETED
  CANCELLED
}

enum ParticipationType {
  INDIVIDUAL_ONLY
  TEAM_ONLY
  BOTH
}

enum JudgingCriteria {
  CREATOR_PICKS
  COMMUNITY_VOTE
  MOST_ENGAGEMENT
  COMBINATION     // Blends Leaderboard Votes and Judge decisions natively
}

enum RequirementType {
  FOLLOW_KRIETA
  YOUTUBE_SUB
  SPOTIFY_FOLLOW
  INSTAGRAM_FOLLOW
  TIKTOK_FOLLOW
  WATCH_VIDEO
  VISIT_SHOP
  CUSTOM
}

model Contest {
  id                String          @id @default(uuid())
  creatorId         String          @map("creator_id")
  title             String
  description       String?
  mediaType         ContestMediaType @map("media_type")
  category          String
  coverMediaUrl     String?         @map("cover_media_url")
  prizeTotalKr      Decimal         @map("prize_total_kr") @db.Decimal(18, 4)
  platformFeeKr     Decimal         @map("platform_fee_kr") @db.Decimal(18, 4)
  
  participationType ParticipationType @default(INDIVIDUAL_ONLY) @map("participation_type")
  teamSize          Int?            @map("team_size")
  maxTeams          Int?            @map("max_teams")
  
  entryFeeKr        Decimal?        @map("entry_fee_kr") @db.Decimal(18, 4)
  publicVoteWeight  Int?            @map("public_vote_weight")
  targetAges        Int[]           @map("target_ages")
  targetGeos        String[]        @map("target_geos")
  airdropKr         Decimal?        @map("airdrop_kr") @db.Decimal(18, 4)
  airdropLimit      Int?            @map("airdrop_limit")
  allowDailyPrizes  Boolean         @default(false) @map("allow_daily_prizes")
  dailyPrizeKr      Decimal?        @map("daily_prize_kr") @db.Decimal(18, 4)
  
  maxWinners        Int             @map("max_winners") @db.SmallInt
  judgingCriteria   JudgingCriteria @map("judging_criteria")
  sponsorName       String?         @map("sponsor_name")
  sponsorUrl        String?         @map("sponsor_url")
  deadline          DateTime
  status            ContestStatus   @default(ACTIVE)
  totalParticipants Int             @default(0) @map("total_participants")
  totalSubmissions  Int             @default(0) @map("total_submissions")
  createdAt         DateTime        @default(now()) @map("created_at")

  creator        User                     @relation(fields: [creatorId], references: [id])
  actions        ContestAction[]
  distributions  ContestPrizeDistribution[]
  participants   ContestParticipant[]
  submissions    ContestSubmission[]
  winners        ContestWinner[]
  escrows        Escrow[]
  shorts         Short[]
  judges         ContestJudge[]
  milestones     Milestone[]
  teamRegistrations TeamContestRegistration[]
  teamSubmissions   TeamSubmission[]
  judgeInvites      JudgeInvite[]     @relation("JudgeInvites")

  // Brand Marketplace Relations
  sponsorships          ContestSponsorship[]
  engagementActions     ContestEngagementAction[]
  purchaseEntries       ContestPurchaseEntry[]
  conversionCampaigns   ConversionCampaign[]
  funnelEvents          SalesFunnelEvent[]
  analytics             ContestAnalytics[]
  promotingCampaigns    BrandCampaign[]

  @@index([status, deadline])
  @@map("contests")
}

model ContestAction {
  id               String          @id @default(uuid())
  contestId        String          @map("contest_id")
  actionType       RequirementType @map("action_type") // Tied correctly to the robust 8 Requirement Templates natively
  targetUrl        String?         @map("target_url")
  label            String
  isVerifiable     Boolean         @default(false) @map("is_verifiable")
  requiresUpload   Boolean         @default(false) @map("requires_upload") // True for Instagram/TikTok proof screenshots!
  sortOrder        Int             @default(0) @map("sort_order")

  contest     Contest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  completions ContestActionCompletion[]

  @@map("contest_actions")
}

model ContestPrizeDistribution {
  id         String  @id @default(uuid())
  contestId  String  @map("contest_id")
  rank       Int
  percentage Decimal @db.Decimal(5, 2)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("contest_prize_distributions")
}

model ContestParticipant {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@map("contest_participants")
}

model ContestSubmission {
  id          String   @id @default(uuid())
  contestId   String   @map("contest_id") // ALWAYS linked to parent contest
  userId      String   @map("user_id")
  mediaUrl    String   @map("media_url")
  mediaType   String   @map("media_type") // photo or video
  proofUrls   String[] @map("proof_urls")
  votesCount  Int      @default(0) @map("votes_count")
  judgeScore  Decimal? @default(0) @map("judge_score") @db.Decimal(5, 2) // Explicit score storing algorithm logic combining Combos
  finalScore  Decimal? @map("final_score") @db.Decimal(7, 2)
  rank        Int?
  submittedAt DateTime @default(now()) @map("submitted_at")

  contest           Contest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionCompletions ContestActionCompletion[]
  votes             ContestVote[]

  @@unique([contestId, userId]) // One submission per user per contest
  @@map("contest_submissions")
}

model ContestActionCompletion {
  id           String  @id @default(uuid())
  submissionId String  @map("submission_id")
  actionId     String  @map("action_id")
  isCompleted  Boolean @default(false) @map("is_completed")
  proofUrl     String? @map("proof_url")

  submission ContestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  action     ContestAction     @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("contest_action_completions")
}

model ContestWinner {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  rank      Int
  prizeKr   Decimal  @map("prize_kr") @db.Decimal(18, 4)
  awardedAt DateTime @default(now()) @map("awarded_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contest_winners")
}

model ContestJudge {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  status    String   @default("pending") // pending, accepted, rejected mapping invite hooks
  addedAt   DateTime @default(now()) @map("added_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@map("contest_judges")
}

enum JudgeInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model JudgeInvite {
  id          String            @id @default(uuid())
  contestId   String            @map("contest_id")
  judgeId     String            @map("judge_id")
  status      JudgeInviteStatus @default(PENDING)
  invitedAt   DateTime          @default(now()) @map("invited_at")
  respondedAt DateTime?         @map("responded_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  contest Contest @relation("JudgeInvites", fields: [contestId], references: [id], onDelete: Cascade)
  judge   User    @relation("JudgeInvites", fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([contestId, judgeId])
  @@index([judgeId])
  @@index([contestId])
  @@index([status])
  @@map("judge_invites")
}

model ContestVote {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  voterId      String   @map("voter_id")
  ipAddress    String?  @map("ip_address") // Protection mapping explicitly against Clickbots!
  fingerprint  String?  @map("fingerprint") // Cross-ref device footprint logic locking abuse loops
  createdAt    DateTime @default(now()) @map("created_at")

  submission ContestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voter      User              @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([submissionId, voterId])
  @@map("contest_votes")
}

// ─── SHOP ─────────────────────────────────────────────────
// ─── SHOP (MULTI-CATEGORY MARKETPLACE) ────────────────────

enum ProductCategory {
  VEHICLES
  SPARE_PARTS
  REAL_ESTATE
  FASHION
  SHOES
  ELECTRONICS
  FOOD_FMCG
  BOOKS
  DIGITAL_PRODUCTS
  SERVICES
  OTHER
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
  FOR_PARTS
}

enum ContactMethod {
  WHATSAPP
  WEBSITE
  PHONE
  IN_APP_CHAT
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  DCT
}

enum VehicleBodyType {
  SEDAN
  COUPE
  HATCHBACK
  SUV
  PICKUP
  VAN
  CONVERTIBLE
  WAGON
  MINIVAN
  BUS
  TRUCK
  TRAILER
  MOTORCYCLE
}

enum FlashSaleType {
  FLASH
  LIGHTNING
  DAILY_FEATURED
  CLEARANCE
}

enum FlashSaleStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ImportRequestStatus {
  PENDING
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GroupBuyStatus {
  OPEN
  THRESHOLD_MET
  CLOSED
  CANCELLED
}

enum LiveStreamType {
  NORMAL
  CHAMA
  CONTEST_BATTLE
  PROOF_OF_TASK
  COMMERCE
}

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum PremiumType {
  FEATURED
  PROMOTED
  TOP_SPOT
}

model Product {
  id              String           @id @default(uuid())
  sellerId        String           @map("seller_id")
  title           String
  description     String?          @db.Text
  imageUrls       String[]         @map("image_urls")
  priceKr         Decimal          @map("price_kr") @db.Decimal(18, 4)
  currency        String?          @db.VarChar(3)
  localPrice      Decimal?         @map("local_price") @db.Decimal(18, 4)
  wholesalePrice  Decimal?         @map("wholesale_price") @db.Decimal(18, 4)
  wholesaleMinQty Int?             @map("wholesale_min_qty")
  bargainEnabled  Boolean          @default(false) @map("bargain_enabled")
  bargainMinPrice Decimal?         @map("bargain_min_price") @db.Decimal(18, 4)
  category        ProductCategory  @default(OTHER)
  subcategory     String?
  condition       ProductCondition @default(NEW)
  brand           String?
  tags            String[]
  whatsappNumber  String?          @map("whatsapp_number")
  purchaseUrl     String?          @map("purchase_url")
  contactMethod   ContactMethod    @default(WHATSAPP)
  location        String?
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  stock           Int              @default(1)
  viewCount       Int              @default(0) @map("view_count")
  salesCount      Int              @default(0) @map("sales_count")
  avgRating       Decimal          @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount     Int              @default(0) @map("review_count")
  isFeatured      Boolean          @default(false) @map("is_featured")
  featuredUntil   DateTime?        @map("featured_until")
  isPromoted      Boolean          @default(false) @map("is_promoted")
  promotedUntil   DateTime?        @map("promoted_until")
  isTopSpot       Boolean          @default(false) @map("is_top_spot")
  topSpotUntil    DateTime?        @map("top_spot_until")
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")

  seller              User                  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  linkedShorts        Short[]
  vehicleDetail       VehicleDetail?
  sparePartDetail     SparePartDetail?
  realEstateDetail    RealEstateDetail?
  fashionDetail       FashionDetail?
  shoeDetail          ShoeDetail?
  electronicsDetail   ElectronicsDetail?
  foodDetail          FoodDetail?
  bookDetail          BookDetail?
  digitalProductDetail DigitalProductDetail?
  serviceDetail       ServiceDetail?
  discounts           ProductDiscount[]
  flashSaleProducts   FlashSaleProduct[]
  reviews             ProductReview[]
  wishlistItems       WishlistItem[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  productShares       ProductShare[]
  productTags         ProductTag[]
  groupBuys           GroupBuy[]
  dealAlerts          DealAlert[]
  livePinnedProducts  LivePinnedProduct[]
  premiumListings     PremiumListing[]
  analytics           ProductAnalytic[]
  vehicleFavorites    VehicleFavorite[]
  liveSessionProducts LiveSessionProduct[] @relation("LiveSessionProducts")

  @@index([status, createdAt])
  @@index([category, status])
  @@index([sellerId, status])
  @@map("products")
}

// ─── CATEGORY DETAIL TABLES ──────────────────────────────

model VehicleDetail {
  id                String          @id @default(uuid())
  productId         String          @unique @map("product_id")
  vehicleType       String          @map("vehicle_type") // car, motorcycle, truck, bus
  make              String
  model             String
  year              Int
  mileage           Int?
  fuelType          FuelType?       @map("fuel_type")
  transmission      TransmissionType?
  bodyType          VehicleBodyType? @map("body_type")
  engineSize        String?         @map("engine_size")
  color             String?
  vin               String?
  numberOfOwners    Int?            @map("number_of_owners")
  logbookReady      Boolean         @default(false) @map("logbook_ready")
  importStatus      String?         @map("import_status") // local, imported
  importCertUrl     String?         @map("import_cert_url")
  auctionSheetUrl   String?         @map("auction_sheet_url")
  accidentHistory   Boolean         @default(false) @map("accident_history")
  tradeInEnabled    Boolean         @default(false) @map("trade_in_enabled")
  swapEnabled       Boolean         @default(false) @map("swap_enabled")


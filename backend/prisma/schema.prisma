  transaction_limited    Boolean   @default(false)
  requires_manual_review Boolean   @default(false)
  last_calculated_at     DateTime  @default(now())
  flagged_reasons        String[]
  created_at             DateTime  @default(now())
  updated_at             DateTime
  risk_level             RiskLevel @default(LOW)

  @@index([last_calculated_at])
  @@index([risk_level])
  @@index([risk_score])
  @@index([user_id])
}

model user_session_secrets {
  id         String   @id
  user_id    String
  secret     Bytes
  expires_at DateTime
  device_id  String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([expires_at])
  @@index([user_id, is_active])
}

model user_suspensions {
  id          String    @id
  user_id     String
  reason      String
  type        String
  suspendedBy String?
  liftedBy    String?
  liftedAt    DateTime?
  expires_at  DateTime?
  created_at  DateTime  @default(now())
  user        user      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([user_id])
}

model user_bookmarks {
  id           String   @id
  user_id      String
  content_id   String
  content_type String
  created_at   DateTime @default(now())

  @@unique([user_id, content_id, content_type])
  @@index([user_id])
  @@index([content_id, content_type])
  @@index([created_at])
}

model vehicle_details {
  id                String            @id
  product_id        String            @unique
  vehicle_type      String
  make              String
  model             String
  year              Int
  mileage           Int?
  fuel_type         FuelType?
  transmission      TransmissionType?
  body_type         VehicleBodyType?
  engine_size       String?
  color             String?
  vin               String?
  number_of_owners  Int?
  logbook_ready     Boolean           @default(false)
  import_status     String?
  import_cert_url   String?
  auction_sheet_url String?
  accident_history  Boolean           @default(false)
  trade_in_enabled  Boolean           @default(false)
  swap_enabled      Boolean           @default(false)
  products          products          @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([body_type])
  @@index([make, model])
  @@index([year])
}

model vehicle_favorites {
  id         String   @id
  user_id    String
  product_id String
  created_at DateTime @default(now())
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model wallets {
  id         String   @id
  user_id    String   @unique
  kr_balance Decimal  @default(0) @db.Decimal(18, 4)
  created_at DateTime @default(now())
  updated_at DateTime
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model withdrawal_limits {
  id                 String   @id
  user_id            String   @unique
  daily_limit_kr     Decimal  @db.Decimal(18, 4)
  withdrawn_today_kr Decimal  @default(0) @db.Decimal(18, 4)
  last_reset_date    DateTime
  created_at         DateTime @default(now())
  updated_at         DateTime

  @@index([user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model withdrawal_requests {
  id                String           @id
  user_id           String
  amount_kr         Decimal          @db.Decimal(18, 4)
  method            String?
  destination       String?
  created_at        DateTime         @default(now())
  updated_at        DateTime
  processed_at      DateTime?
  status            WithdrawalStatus @default(PENDING)
  account_details   Json?
  account_name      String?
  amount_fiat       Decimal?         @db.Decimal(18, 4)
  currency          String?
  flag_reason       String?
  flagged_at        DateTime?
  kyc_document_ids  String[]         @default([])
  metadata          Json?
  name_match_status String?
  provider          String?
  requires_kyc      Boolean          @default(false)
  review_note       String?
  reviewed_at       DateTime?
  reviewed_by       String?
  risk_score        Int              @default(0)
  suspicious_flags  Json?
  user              user             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([risk_score])
  @@index([status, created_at])
  @@index([user_id, status])
}


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  
}

datasource db {
  provider = "postgresql"
}

// ─── USERS ────────────────────────────────────────────────

enum AccountType {
  CREATOR
  BUSINESS
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  username        String      @unique
  firstName       String      @map("first_name")
  lastName        String      @map("last_name")
  displayName     String      @map("display_name")
  avatarUrl       String?     @map("avatar_url")
  coverPhotoUrl   String?     @map("cover_photo_url")
  bio             String?
  country         String      @db.VarChar(2) // ISO country code
  currency        String      @db.VarChar(3) // ISO currency code
  googleId        String?     @unique @map("google_id")
  appleId         String?     @unique @map("apple_id")
  accountType     AccountType @default(CREATOR) @map("account_type")
  isAdmin         Boolean     @default(false) @map("is_admin") 
  isVerified      Boolean     @default(false) @map("is_verified")
  
  // Wallet Security 
  isWalletUnlocked Boolean    @default(false) @map("is_wallet_unlocked")
  walletPinHash   String?     @map("wallet_pin_hash")
  
  passwordHash    String?     @map("password_hash")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  wallet              Wallet?
  refreshTokens       RefreshToken[]
  bioLinks            BioLink[]
  admirers            Admire[]          @relation("AdmiredBy")
  admiring            Admire[]          @relation("Admirer")
  subscriptionTiers   SubscriptionTier[]
  subscribedTo        Subscription[]    @relation("Subscriber")
  subscribers         Subscription[]    @relation("Creator")
  milestoneCompletions MilestoneCompletion[]
  shorts              Short[]
  shortLikes          ShortLike[]
  shortComments       ShortComment[]
  shortCollections    ShortCollection[]
  posts               Post[]
  postLikes           PostLike[]
  postComments        PostComment[]
  contestsCreated     Contest[]
  contestParticipations ContestParticipant[]
  contestSubmissions  ContestSubmission[]
  contestWins         ContestWinner[]
  contestJudges       ContestJudge[]
  contestVotes        ContestVote[]
  transactions        Transaction[]
  escrows             Escrow[]
  products            Product[]
  dailyStats          DailyStat[]
  comments            Comment[]         @relation("CommentAuthor")
  commentLikes        CommentLike[]     @relation("CommentLikes")
  commentReports      CommentReport[]   @relation("CommentReports")
  commentRepliesTo    Comment[]         @relation("CommentReplyTo")
  teamsLed            Team[]            @relation("TeamLeader")
  teamMemberships     TeamMember[]      @relation("TeamMemberships")
  teamInvitationsSent TeamInvitation[]  @relation("TeamInvitationsSent")
  teamInvitationsReceived TeamInvitation[] @relation("TeamInvitationsReceived")
  teamSubmissionVotes TeamSubmissionVote[] @relation("TeamSubmissionVotes")
  judgeInvites        JudgeInvite[]     @relation("JudgeInvites")

  @@map("users")
}

// ─── AUTH ──────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  deviceId  String   @map("device_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── WALLET ───────────────────────────────────────────────

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  krBalance Decimal  @default(0) @map("kr_balance") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  type           String   // topup, withdraw, tip_sent, tip_received, contest_escrow, contest_prize, subscription_earned, subscription_paid, shop_sale, ad_revenue, platform_fee
  amountKr       Decimal  @map("amount_kr") @db.Decimal(18, 4)
  amountFiat     Decimal? @map("amount_fiat") @db.Decimal(18, 4)
  currency       String?  @db.VarChar(3)
  provider       String?  // paypal, paystack, mpesa, payoneer, platform
  status         String   @default("pending") // pending, completed, failed, cancelled
  reference      String?
  counterpartyId String?  @map("counterparty_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("transactions")
}

model Escrow {
  id            String   @id @default(uuid())
  contestId     String   @map("contest_id")
  userId        String   @map("user_id")
  prizeAmountKr Decimal  @map("prize_amount_kr") @db.Decimal(18, 4)
  feeAmountKr   Decimal  @map("fee_amount_kr") @db.Decimal(18, 4)
  status        String   @default("held") // held, released, refunded
  createdAt     DateTime @default(now()) @map("created_at")

  contest Contest @relation(fields: [contestId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("escrows")
}

// ─── SOCIAL ───────────────────────────────────────────────

model Admire {
  id        String   @id @default(uuid())
  admirerId String   @map("admirer_id")
  admiredId String   @map("admired_id")
  isLovers  Boolean  @default(false) @map("is_lovers")
  createdAt DateTime @default(now()) @map("created_at")

  admirer User @relation("Admirer", fields: [admirerId], references: [id], onDelete: Cascade)
  admired User @relation("AdmiredBy", fields: [admiredId], references: [id], onDelete: Cascade)

  @@unique([admirerId, admiredId])
  @@map("admires")
}

model BioLink {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  label     String
  url       String
  icon      String?
  sortOrder Int    @default(0) @map("sort_order")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bio_links")
}

// ─── SUBSCRIPTIONS ────────────────────────────────────────

enum SubscriptionTierType {
  TOP_FUN
  REAL_FAN
  TRUE_FAN
  SUPER_FAN
}

model SubscriptionTier {
  id        String               @id @default(uuid())
  creatorId String               @map("creator_id")
  tier      SubscriptionTierType
  krAmount  Decimal              @map("kr_amount") @db.Decimal(18, 4)
  benefits  String
  isEnabled Boolean              @default(true) @map("is_enabled")
  createdAt DateTime             @default(now()) @map("created_at")

  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([creatorId, tier])
  @@map("subscription_tiers")
}

model Subscription {
  id            String               @id @default(uuid())
  subscriberId  String               @map("subscriber_id")
  creatorId     String               @map("creator_id")
  tierId        String               @map("tier_id")
  tier          SubscriptionTierType
  krAmount      Decimal              @map("kr_amount") @db.Decimal(18, 4)
  status        String               @default("active") // active, cancelled, expired
  startedAt     DateTime             @default(now()) @map("started_at")
  nextBillingAt DateTime?            @map("next_billing_at")
  cancelledAt   DateTime?            @map("cancelled_at")

  subscriber     User             @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator        User             @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptionTier SubscriptionTier @relation(fields: [tierId], references: [id])

  @@unique([subscriberId, creatorId])
  @@map("subscriptions")
}

// ─── MILESTONES ───────────────────────────────────────────

model Milestone {
  id               String   @id @default(uuid())
  title            String
  description      String
  requirementType  String   @map("requirement_type")
  requirementValue Int      @map("requirement_value")
  rewardKr         Decimal  @map("reward_kr") @db.Decimal(18, 4)
  contestId        String?  @map("contest_id") // Optional link bridging Contest Airdrop FOMO natively
  createdAt        DateTime @default(now()) @map("created_at")

  completions MilestoneCompletion[]
  contest     Contest?              @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model MilestoneCompletion {
  id          String   @id @default(uuid())
  milestoneId String   @map("milestone_id")
  userId      String   @map("user_id")
  completedAt DateTime @default(now()) @map("completed_at")

  milestone Milestone @relation(fields: [milestoneId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([milestoneId]) // Only first user can complete
  @@map("milestone_completions")
}

// ─── SHORTS ───────────────────────────────────────────────

model Short {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  videoUrl        String   @map("video_url")
  thumbnailUrl    String?  @map("thumbnail_url")
  caption         String?
  musicTitle      String?  @map("music_title")
  musicArtist     String?  @map("music_artist")
  isLocked        Boolean  @default(false) @map("is_locked")
  requiredTier    SubscriptionTierType? @map("required_tier")
  contestId       String?  @map("contest_id")
  collectionId    String?  @map("collection_id")
  linkedProductId String?  @map("linked_product_id") // Shop product shown briefly during playback
  views           Int      @default(0)
  likesCount      Int      @default(0) @map("likes_count")
  commentsCount   Int      @default(0) @map("comments_count")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest       Contest?         @relation(fields: [contestId], references: [id])
  collection    ShortCollection? @relation(fields: [collectionId], references: [id])
  linkedProduct Product?         @relation(fields: [linkedProductId], references: [id])
  likes         ShortLike[]
  comments      ShortComment[]

  @@index([userId, createdAt])
  @@map("shorts")
}

model ShortCollection {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  coverUrl  String?  @map("cover_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shorts Short[]

  @@map("short_collections")
}

model ShortLike {
  id        String   @id @default(uuid())
  shortId   String   @map("short_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  short Short @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shortId, userId])
  @@map("short_likes")
}

model ShortComment {
  id        String   @id @default(uuid())
  shortId   String   @map("short_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  short Short @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("short_comments")
}

// ─── FEED POSTS ───────────────────────────────────────────

model Post {
  id            String               @id @default(uuid())
  userId        String               @map("user_id")
  caption       String?
  imageUrls     String[]             @map("image_urls")
  isLocked      Boolean              @default(false) @map("is_locked")
  requiredTier  SubscriptionTierType? @map("required_tier")
  likesCount    Int                  @default(0) @map("likes_count")
  commentsCount Int                  @default(0) @map("comments_count")
  createdAt     DateTime             @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]

  @@index([userId, createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("post_comments")
}

// ─── CONTESTS (CORE) ──────────────────────────────────────

enum ContestMediaType {
  PHOTO
  VIDEO
  PHOTO_AND_VIDEO
}

enum ContestStatus {
  DRAFT
  ACTIVE
  JUDGING
  PENDING_PAYOUT
  COMPLETED
  CANCELLED
}

enum ParticipationType {
  INDIVIDUAL_ONLY
  TEAM_ONLY
  BOTH
}

enum JudgingCriteria {
  CREATOR_PICKS
  COMMUNITY_VOTE
  MOST_ENGAGEMENT
  COMBINATION     // Blends Leaderboard Votes and Judge decisions natively
}

enum RequirementType {
  FOLLOW_KRIETA
  YOUTUBE_SUB
  SPOTIFY_FOLLOW
  INSTAGRAM_FOLLOW
  TIKTOK_FOLLOW
  WATCH_VIDEO
  VISIT_SHOP
  CUSTOM
}

model Contest {
  id                String          @id @default(uuid())
  creatorId         String          @map("creator_id")
  title             String
  description       String?
  mediaType         ContestMediaType @map("media_type")
  category          String
  coverMediaUrl     String?         @map("cover_media_url")
  prizeTotalKr      Decimal         @map("prize_total_kr") @db.Decimal(18, 4)
  platformFeeKr     Decimal         @map("platform_fee_kr") @db.Decimal(18, 4)
  
  participationType ParticipationType @default(INDIVIDUAL_ONLY) @map("participation_type")
  teamSize          Int?            @map("team_size")
  maxTeams          Int?            @map("max_teams")
  
  entryFeeKr        Decimal?        @map("entry_fee_kr") @db.Decimal(18, 4)
  publicVoteWeight  Int?            @map("public_vote_weight")
  targetAges        Int[]           @map("target_ages")
  targetGeos        String[]        @map("target_geos")
  airdropKr         Decimal?        @map("airdrop_kr") @db.Decimal(18, 4)
  airdropLimit      Int?            @map("airdrop_limit")
  allowDailyPrizes  Boolean         @default(false) @map("allow_daily_prizes")
  dailyPrizeKr      Decimal?        @map("daily_prize_kr") @db.Decimal(18, 4)
  
  maxWinners        Int             @map("max_winners") @db.SmallInt
  judgingCriteria   JudgingCriteria @map("judging_criteria")
  sponsorName       String?         @map("sponsor_name")
  sponsorUrl        String?         @map("sponsor_url")
  deadline          DateTime
  status            ContestStatus   @default(ACTIVE)
  totalParticipants Int             @default(0) @map("total_participants")
  totalSubmissions  Int             @default(0) @map("total_submissions")
  createdAt         DateTime        @default(now()) @map("created_at")

  creator        User                     @relation(fields: [creatorId], references: [id])
  actions        ContestAction[]
  distributions  ContestPrizeDistribution[]
  participants   ContestParticipant[]
  submissions    ContestSubmission[]
  winners        ContestWinner[]
  escrows        Escrow[]
  shorts         Short[]
  judges         ContestJudge[]
  milestones     Milestone[]
  teamRegistrations TeamContestRegistration[]
  teamSubmissions   TeamSubmission[]
  judgeInvites      JudgeInvite[]     @relation("JudgeInvites")

  @@index([status, deadline])
  @@map("contests")
}

model ContestAction {
  id               String          @id @default(uuid())
  contestId        String          @map("contest_id")
  actionType       RequirementType @map("action_type") // Tied correctly to the robust 8 Requirement Templates natively
  targetUrl        String?         @map("target_url")
  label            String
  isVerifiable     Boolean         @default(false) @map("is_verifiable")
  requiresUpload   Boolean         @default(false) @map("requires_upload") // True for Instagram/TikTok proof screenshots!
  sortOrder        Int             @default(0) @map("sort_order")

  contest     Contest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  completions ContestActionCompletion[]

  @@map("contest_actions")
}

model ContestPrizeDistribution {
  id         String  @id @default(uuid())
  contestId  String  @map("contest_id")
  rank       Int
  percentage Decimal @db.Decimal(5, 2)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@map("contest_prize_distributions")
}

model ContestParticipant {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@map("contest_participants")
}

model ContestSubmission {
  id          String   @id @default(uuid())
  contestId   String   @map("contest_id") // ALWAYS linked to parent contest
  userId      String   @map("user_id")
  mediaUrl    String   @map("media_url")
  mediaType   String   @map("media_type") // photo or video
  proofUrls   String[] @map("proof_urls")
  votesCount  Int      @default(0) @map("votes_count")
  judgeScore  Decimal? @default(0) @map("judge_score") @db.Decimal(5, 2) // Explicit score storing algorithm logic combining Combos
  finalScore  Decimal? @map("final_score") @db.Decimal(7, 2)
  rank        Int?
  submittedAt DateTime @default(now()) @map("submitted_at")

  contest           Contest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionCompletions ContestActionCompletion[]
  votes             ContestVote[]

  @@unique([contestId, userId]) // One submission per user per contest
  @@map("contest_submissions")
}

model ContestActionCompletion {
  id           String  @id @default(uuid())
  submissionId String  @map("submission_id")
  actionId     String  @map("action_id")
  isCompleted  Boolean @default(false) @map("is_completed")
  proofUrl     String? @map("proof_url")

  submission ContestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  action     ContestAction     @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("contest_action_completions")
}

model ContestWinner {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  rank      Int
  prizeKr   Decimal  @map("prize_kr") @db.Decimal(18, 4)
  awardedAt DateTime @default(now()) @map("awarded_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contest_winners")
}

model ContestJudge {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  status    String   @default("pending") // pending, accepted, rejected mapping invite hooks
  addedAt   DateTime @default(now()) @map("added_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@map("contest_judges")
}

enum JudgeInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model JudgeInvite {
  id          String            @id @default(uuid())
  contestId   String            @map("contest_id")
  judgeId     String            @map("judge_id")
  status      JudgeInviteStatus @default(PENDING)
  invitedAt   DateTime          @default(now()) @map("invited_at")
  respondedAt DateTime?         @map("responded_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  contest Contest @relation("JudgeInvites", fields: [contestId], references: [id], onDelete: Cascade)
  judge   User    @relation("JudgeInvites", fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([contestId, judgeId])
  @@index([judgeId])
  @@index([contestId])
  @@index([status])
  @@map("judge_invites")
}

model ContestVote {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  voterId      String   @map("voter_id")
  ipAddress    String?  @map("ip_address") // Protection mapping explicitly against Clickbots!
  fingerprint  String?  @map("fingerprint") // Cross-ref device footprint logic locking abuse loops
  createdAt    DateTime @default(now()) @map("created_at")

  submission ContestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voter      User              @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([submissionId, voterId])
  @@map("contest_votes")
}

// ─── SHOP ─────────────────────────────────────────────────

model Product {
  id              String   @id @default(uuid())
  sellerId        String   @map("seller_id")
  title           String
  description     String?
  imageUrls       String[] @map("image_urls")
  priceKr         Decimal  @map("price_kr") @db.Decimal(18, 4)
  category        String?
  whatsappNumber  String   @map("whatsapp_number")
  status          String   @default("active") // active, sold, removed
  createdAt       DateTime @default(now()) @map("created_at")

  seller       User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  linkedShorts Short[] // Shorts that link to this product

  @@index([status, createdAt])
  @@map("products")
}

// ─── ANALYTICS ────────────────────────────────────────────

model DailyStat {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  date        DateTime @db.Date
  views       Int      @default(0)
  likes       Int      @default(0)
  newAdmirers Int      @default(0) @map("new_admirers")
  krEarned    Decimal  @default(0) @map("kr_earned") @db.Decimal(18, 4)
  krSpent     Decimal  @default(0) @map("kr_spent") @db.Decimal(18, 4)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_stats")
}

// ─── COMMENTS ─────────────────────────────────────────────

model Comment {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  contentId     String    @map("content_id")
  contentType   String    @map("content_type")
  text          String
  parentId      String?   @map("parent_id")
  replyToUserId String?   @map("reply_to_user_id")
  likesCount    Int       @default(0) @map("likes_count")
  repliesCount  Int       @default(0) @map("replies_count")
  isPinned      Boolean   @default(false) @map("is_pinned")
  isEdited      Boolean   @default(false) @map("is_edited")
  createdAt     DateTime  @default(now()) @map("created_at")
  editedAt      DateTime? @map("edited_at")

  author       User           @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  parent       Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]      @relation("CommentReplies")
  replyToUser  User?          @relation("CommentReplyTo", fields: [replyToUserId], references: [id], onDelete: SetNull)
  likes        CommentLike[]
  reports      CommentReport[]

  @@index([contentType, contentId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([isPinned, createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

model CommentReport {
  id         String   @id @default(uuid())
  commentId  String   @map("comment_id")
  reporterId String   @map("reporter_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation("CommentReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_reports")
}

model CommentSettings {
  id              String  @id @default(uuid())
  contentId       String  @map("content_id")
  contentType     String  @map("content_type")
  commentsEnabled Boolean @default(true) @map("comments_enabled")
  repliesEnabled  Boolean @default(true) @map("replies_enabled")

  @@unique([contentId, contentType])
  @@map("comment_settings")
}

// ─── TEAMS ────────────────────────────────────────────────

enum TeamRole {
  LEADER
  CO_LEADER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  avatarUrl   String?  @map("avatar_url")
  leaderId    String   @map("leader_id")
  maxMembers  Int      @default(5) @map("max_members")
  totalWins   Int      @default(0) @map("total_wins")
  totalPrizes Decimal  @default(0) @map("total_prizes") @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leader        User                      @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  invitations   TeamInvitation[]
  registrations TeamContestRegistration[]
  submissions   TeamSubmission[]
  chat          TeamChat?

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("TeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id         String           @id @default(uuid())
  teamId     String           @map("team_id")
  inviterId  String           @map("inviter_id")
  inviteeId  String           @map("invitee_id")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter  User @relation("TeamInvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee  User @relation("TeamInvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([teamId, inviteeId, status])
  @@index([inviteeId, status])
  @@index([teamId, status])
  @@map("team_invitations")
}

model TeamContestRegistration {
  id           String   @id @default(uuid())
  contestId    String   @map("contest_id")
  teamId       String   @map("team_id")
  registeredAt DateTime @default(now()) @map("registered_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([contestId, teamId])
  @@index([contestId])
  @@index([teamId])
  @@map("team_contest_registrations")
}

model TeamSubmission {
  id           String   @id @default(uuid())
  contestId    String   @map("contest_id")
  teamId       String   @map("team_id")
  mediaUrl     String   @map("media_url")
  mediaType    String   @map("media_type")
  caption      String?
  contributors String[] // Array of user IDs
  votesCount   Int      @default(0) @map("votes_count")
  judgeScore   Decimal? @default(0) @map("judge_score") @db.Decimal(5, 2)
  finalScore   Decimal? @map("final_score") @db.Decimal(7, 2)
  rank         Int?
  submittedAt  DateTime @default(now()) @map("submitted_at")

  contest Contest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  team    Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  votes   TeamSubmissionVote[]

  @@unique([contestId, teamId])
  @@index([contestId, votesCount])
  @@map("team_submissions")
}

model TeamSubmissionVote {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  voterId      String   @map("voter_id")
  createdAt    DateTime @default(now()) @map("created_at")

  submission TeamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voter      User           @relation("TeamSubmissionVotes", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([submissionId, voterId])
  @@index([submissionId])
  @@map("team_submission_votes")
}

model TeamChat {
  id        String   @id @default(uuid())
  teamId    String   @unique @map("team_id")
  chatId    String   @map("chat_id")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_chats")
}

// ─── HASHTAGS & MENTIONS ──────────────────────────────────

model Hashtag {
  id          String   @id @default(uuid())
  tag         String   @unique // normalized lowercase, no #
  usageCount  Int      @default(1) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")

  contentTags ContentHashtag[]

  @@index([usageCount])
  @@map("hashtags")
}

model ContentHashtag {
  id          String   @id @default(uuid())
  hashtagId   String   @map("hashtag_id")
  contentId   String   @map("content_id")
  contentType String   @map("content_type") // POST, SHORT, CONTEST
  createdAt   DateTime @default(now()) @map("created_at")

  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([hashtagId, contentId, contentType])
  @@index([contentId, contentType])
  @@index([hashtagId])
  @@map("content_hashtags")
}

model ContentMention {
  id              String   @id @default(uuid())
  mentionedUserId String   @map("mentioned_user_id")
  contentId       String   @map("content_id")
  contentType     String   @map("content_type") // POST, SHORT, CONTEST
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([mentionedUserId, contentId, contentType])
  @@index([contentId, contentType])
  @@index([mentionedUserId])
  @@map("content_mentions")
}

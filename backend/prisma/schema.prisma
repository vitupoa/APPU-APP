model call {
  id           String             @id @default(uuid())
  chat_id      String
  caller_id    String
  type         CallType
  status       CallStatus         @default(RINGING)
  started_at   DateTime?
  ended_at     DateTime?
  duration_secs Int?
  created_at   DateTime           @default(now())
  chat         chat               @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  participants call_participants[]

  @@index([chat_id])
  @@index([caller_id])
  @@index([status])
  @@map("call")
}

model call_participants {
  id         String    @id @default(uuid())
  call_id    String
  user_id    String
  status     CallParticipantStatus @default(invited)
  joined_at  DateTime?
  left_at    DateTime?
  created_at DateTime  @default(now())
  call       call      @relation(fields: [call_id], references: [id], onDelete: Cascade)

  @@unique([call_id, user_id])
  @@index([call_id])
  @@index([user_id])
  @@map("call_participants")
}


// ═══════════════════════════════════════════════════════════
// SOCIAL MEDIA INTEGRATION FOR INFLUENCER PROFILES
// ═══════════════════════════════════════════════════════════

enum SocialPlatform {
  TIKTOK
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  TWITTER
  TWITCH
  LINKEDIN
  SNAPCHAT
}

model SocialMediaAccount {
  id                String         @id @default(uuid())
  influencerId      String         @map("influencer_id")
  platform          SocialPlatform
  
  username          String
  profileUrl        String         @map("profile_url")
  displayName       String?        @map("display_name")
  
  followerCount     Int            @default(0) @map("follower_count")
  subscriberCount   Int            @default(0) @map("subscriber_count")
  videoCount        Int            @default(0) @map("video_count")
  totalViews        BigInt         @default(0) @map("total_views")
  avgViews          Int            @default(0) @map("avg_views")
  avgLikes          Int            @default(0) @map("avg_likes")
  engagementRate    Decimal        @default(0) @map("engagement_rate") @db.Decimal(5, 2)
  
  isVerified        Boolean        @default(false) @map("is_verified")
  isPrimary         Boolean        @default(false) @map("is_primary")
  
  lastSyncedAt      DateTime?      @map("last_synced_at")
  syncStatus        String         @default("pending") @map("sync_status")
  syncError         String?        @map("sync_error")
  
  accessToken       String?        @map("access_token") @db.Text
  refreshToken      String?        @map("refresh_token") @db.Text
  tokenExpiresAt    DateTime?      @map("token_expires_at")
  
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  influencer        InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([influencerId, platform])
  @@index([platform, followerCount])
  @@index([influencerId, isPrimary])
  @@map("social_media_accounts")
}

model SocialMediaSyncLog {
  id                String         @id @default(uuid())
  accountId         String         @map("account_id")
  
  syncType          String         @map("sync_type")
  status            String
  
  followersBefore   Int            @map("followers_before")
  followersAfter    Int            @map("followers_after")
  followerChange    Int            @map("follower_change")
  
  errorMessage      String?        @map("error_message")
  errorCode         String?        @map("error_code")
  
  durationMs        Int            @map("duration_ms")
  
  syncedAt          DateTime       @default(now()) @map("synced_at")

  @@index([accountId, syncedAt])
  @@index([status])
  @@map("social_media_sync_logs")
}

model PlatformRateLimit {
  id                String         @id @default(uuid())
  platform          SocialPlatform
  
  requestsPerHour   Int            @map("requests_per_hour")
  requestsRemaining Int            @map("requests_remaining")
  resetAt           DateTime       @map("reset_at")
  
  lastRequestAt     DateTime?      @map("last_request_at")
  
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@unique([platform])
  @@map("platform_rate_limits")
}

// ─── REMBRANDT RAR (PLATFORM GOVERNANCE) ──────────────────

enum AdminRole {
  SUPER_ADMIN
  CONTENT_MODERATOR
  FINANCIAL_ADMIN
  SUPPORT_ADMIN
  MARKETING_ADMIN
  ANALYTICS_ADMIN
  SECURITY_ADMIN
  COMMUNITY_MANAGER
}

enum FeatureFlagScope {
  GLOBAL
  CONTINENT
  COUNTRY
  REGION
  CITY
  USER
}

enum WithdrawalStatus {
  PENDING
  FLAGGED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum SuspensionType {
  SUSPENDED
  BANNED
  BLOCKED
}

model AdminProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  role        AdminRole
  permissions Json?
  grantedBy   String?   @map("granted_by")
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model FeatureFlag {
  id         String           @id @default(uuid())
  featureKey String           @map("feature_key")
  isEnabled  Boolean          @default(true) @map("is_enabled")
  scope      FeatureFlagScope @default(GLOBAL)
  scopeValue String?          @map("scope_value")
  priority   Int              @default(0)
  createdBy  String?          @map("created_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([featureKey, scope, scopeValue])
  @@index([featureKey, scope])
  @@map("feature_flags")
}

model ProhibitedName {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   // "username", "display_name", "both"
  reason    String?
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("prohibited_names")
}

model ReservedUsername {
  id          String   @id @default(uuid())
  username    String   @unique
  reservedFor String?  @map("reserved_for")
  reason      String?
  reservedBy  String?  @map("reserved_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reserved_usernames")
}

model WithdrawalRequest {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  amountKr        Decimal          @map("amount_kr") @db.Decimal(18, 4)
  amountFiat      Decimal?         @map("amount_fiat") @db.Decimal(18, 4)
  currency        String           @db.VarChar(3)
  provider        String           // "mpesa", "bank", "paypal", "payoneer"
  accountName     String           @map("account_name")
  accountDetails  Json             @map("account_details")
  nameMatchStatus String           @default("pending") @map("name_match_status") // "match", "mismatch", "pending"
  status          WithdrawalStatus @default(PENDING)
  reviewedBy      String?          @map("reviewed_by")
  reviewNote      String?          @map("review_note")
  reviewedAt      DateTime?        @map("reviewed_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("withdrawal_requests")
}

model PlatformWallet {
  id        String   @id @default(uuid())
  krBalance Decimal  @default(0) @map("kr_balance") @db.Decimal(18, 4)
  label     String   @default("main") // "main", "escrow_reserve", "fee_pool"
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([label])
  @@map("platform_wallets")
}

model UserSuspension {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  reason      String
  suspendedBy String         @map("suspended_by")
  type        SuspensionType
  expiresAt   DateTime?      @map("expires_at")
  liftedAt    DateTime?      @map("lifted_at")
  liftedBy    String?        @map("lifted_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_suspensions")
}

model PlatformAnnouncement {
  id          String    @id @default(uuid())
  title       String
  message     String    @db.Text
  type        String    // "banner", "push", "email", "in_app"
  targetScope String    @default("all") @map("target_scope")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String    @map("created_by")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("platform_announcements")
}

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_configs")
}

model ContentModerationLog {
  id          String   @id @default(uuid())
  adminId     String   @map("admin_id")
  contentType String   @map("content_type") // "short", "post", "contest", "comment", "product", "story"
  contentId   String   @map("content_id")
  action      String   // "hide", "delete", "approve", "flag", "restore"
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([contentType, contentId])
  @@map("content_moderation_logs")
}

// ═══════════════════════════════════════════════════════════
// LIVE SHOPPING SESSION MODELS
// Add these models to your main schema.prisma file
// ═══════════════════════════════════════════════════════════

model LiveSession {
  id              String   @id @default(uuid())
  hostId          String   @map("host_id")
  title           String
  description     String?  @db.Text
  scheduledStart  DateTime @map("scheduled_start")
  actualStart     DateTime? @map("actual_start")
  endedAt         DateTime? @map("ended_at")
  status          String   @default("SCHEDULED") // SCHEDULED, LIVE, ENDED
  viewerCount     Int      @default(0) @map("viewer_count")
  peakViewers     Int      @default(0) @map("peak_viewers")
  totalSalesKr    Decimal  @default(0) @map("total_sales_kr") @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at")

  host     User                 @relation("LiveSessionHost", fields: [hostId], references: [id], onDelete: Cascade)
  products LiveSessionProduct[]

  @@index([hostId, status])
  @@index([status, scheduledStart])
  @@map("live_sessions")
}

model LiveSessionProduct {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  productId   String   @map("product_id")
  salePrice   Decimal? @map("sale_price") @db.Decimal(18, 4)
  unitsSold   Int      @default(0) @map("units_sold")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product     @relation("LiveSessionProducts", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId])
  @@map("live_session_products")
}

// ═══════════════════════════════════════════════════════════
// SPONSORED CONTENT / NATIVE ADS MODELS
// Add these models to your main schema.prisma file
// ═══════════════════════════════════════════════════════════

enum SponsoredContentStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum PricingModel {
  CPM  // Cost per 1000 impressions
  CPV  // Cost per view (3+ seconds)
  CPE  // Cost per engagement (like/comment/share)
  CPC  // Cost per click
}

model SponsoredContent {
  id            String                  @id @default(uuid())
  brandUserId   String                  @map("brand_user_id")
  contentType   String                  @map("content_type") // short, post
  contentId     String                  @map("content_id")
  campaignName  String                  @map("campaign_name")
  
  // Budget & Pricing
  budget        Decimal                 @db.Decimal(18, 4)
  spent         Decimal                 @default(0) @db.Decimal(18, 4)
  pricingModel  PricingModel            @map("pricing_model")
  bidAmount     Decimal                 @map("bid_amount") @db.Decimal(18, 4)
  
  // Targeting
  targeting     Json?                   // { ageMin, ageMax, gender[], countries[], interests[] }
  
  // Schedule
  startDate     DateTime                @map("start_date")
  endDate       DateTime                @map("end_date")
  
  // Metrics
  impressions   Int                     @default(0)
  views         Int                     @default(0)
  engagements   Int                     @default(0)
  clicks        Int                     @default(0)
  
  // Status
  status        SponsoredContentStatus  @default(PENDING_REVIEW)
  escrowId      String?                 @map("escrow_id")
  
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  brand         User                    @relation("SponsoredContentBrand", fields: [brandUserId], references: [id], onDelete: Cascade)
  short         Short?                  @relation("SponsoredShort", fields: [contentId], references: [id], onDelete: Cascade, map: "sponsored_content_short_fkey")
  post          Post?                   @relation("SponsoredPost", fields: [contentId], references: [id], onDelete: Cascade, map: "sponsored_content_post_fkey")
  impressionLog SponsoredImpression[]

  @@index([brandUserId, status])
  @@index([status, startDate, endDate])
  @@index([contentType, contentId])
  @@map("sponsored_content")
}

model SponsoredImpression {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  userId      String   @map("user_id")
  type        String   // impression, view, like, comment, share, click
  cost        Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  campaign SponsoredContent @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
  @@index([userId, createdAt])
  @@map("sponsored_impressions")
}


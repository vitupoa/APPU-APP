model influencer_profiles {
  id                    String                  @id
  user_id               String                  @unique
  tier                  InfluencerTier
  bio                   String?
  categories            String[]
  avg_engagement_rate   Decimal                 @default(0) @db.Decimal(5, 2)
  avg_views             Int                     @default(0)
  rate_per_post         Decimal?                @db.Decimal(18, 4)
  rate_per_video        Decimal?                @db.Decimal(18, 4)
  rate_per_story        Decimal?                @db.Decimal(18, 4)
  is_available          Boolean                 @default(true)
  is_verified           Boolean                 @default(false)
  verified_at           DateTime?
  total_campaigns       Int                     @default(0)
  total_earnings_kr     Decimal                 @default(0) @db.Decimal(18, 4)
  avg_rating            Decimal                 @default(0) @db.Decimal(3, 2)
  created_at            DateTime                @default(now())
  updated_at            DateTime
  campaign_applications campaign_applications[]
  campaign_deliverables campaign_deliverables[]
  User                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  influencer_portfolio  influencer_portfolio[]
  influencer_reviews    influencer_reviews[]
  social_media_accounts social_media_accounts[]

  @@index([avg_engagement_rate])
  @@index([tier, is_available])
}

model influencer_portfolio {
  id            String              @id
  influencer_id String
  title         String
  description   String?
  media_url     String
  media_type    String
  platform      String
  views         Int                 @default(0)
  likes         Int                 @default(0)
  comments      Int                 @default(0)
  shares        Int                 @default(0)
  created_at    DateTime            @default(now())
  influencer_profiles influencer_profiles @relation(fields: [influencer_id], references: [id], onDelete: Cascade)

  @@index([influencer_id])
}

model influencer_reviews {
  id                   String              @id
  campaign_id          String
  influencer_id        String
  brand_id             String
  rating               Int
  review               String?
  communication_rating Int
  quality_rating       Int
  timeliness_rating    Int
  created_at           DateTime            @default(now())
  influencer_profiles  influencer_profiles @relation(fields: [influencer_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, influencer_id])
  @@index([influencer_id])
}

model judge_invites {
  id           String            @id
  contest_id   String
  judge_id     String
  status       JudgeInviteStatus @default(PENDING)
  invited_at   DateTime          @default(now())
  responded_at DateTime?
  created_at   DateTime          @default(now())
  updated_at   DateTime
  Contest      Contest           @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User         User              @relation(fields: [judge_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, judge_id])
  @@index([contest_id])
  @@index([judge_id])
  @@index([status])
}

model live_banned_viewers {
  id         String     @id
  stream_id  String
  user_id    String
  reason     String?
  banned_at  DateTime   @default(now())
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@unique([stream_id, user_id])
}

model live_battles {
  id                                                     String       @id
  stream_id                                              String
  opponent_stream_id                                     String
  contest_id                                             String?
  duration_secs                                          Int          @default(300)
  status                                                 BattleStatus @default(PENDING)
  host_score                                             Decimal      @default(0) @db.Decimal(18, 4)
  opponent_score                                         Decimal      @default(0) @db.Decimal(18, 4)
  winner_id                                              String?
  started_at                                             DateTime?
  ended_at                                               DateTime?
  created_at                                             DateTime     @default(now())
  LiveStream_live_battles_opponent_stream_idToLiveStream LiveStream   @relation("live_battles_opponent_stream_idToLiveStream", fields: [opponent_stream_id], references: [id], onDelete: Cascade)
  LiveStream_live_battles_stream_idToLiveStream          LiveStream   @relation("live_battles_stream_idToLiveStream", fields: [stream_id], references: [id], onDelete: Cascade)
}

model live_co_hosts {
  id         String     @id
  stream_id  String
  user_id    String
  joined_at  DateTime   @default(now())
  left_at    DateTime?
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@unique([stream_id, user_id])
}

model live_messages {
  id         String     @id
  stream_id  String
  user_id    String
  text       String
  is_system  Boolean    @default(false)
  is_pinned  Boolean    @default(false)
  created_at DateTime   @default(now())
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@index([stream_id, created_at])
}

model live_pinned_products {
  id         String     @id
  stream_id  String
  product_id String
  sale_price Decimal?   @db.Decimal(18, 4)
  is_pinned  Boolean    @default(false)
  pinned_at  DateTime?
  units_sold Int        @default(0)
  sort_order Int        @default(0)
  products   products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@unique([stream_id, product_id])
}

model live_session_products {
  id          String      @id
  session_id  String
  product_id  String
  sale_price  Decimal?    @db.Decimal(18, 4)
  units_sold  Int         @default(0)
  sort_order  Int         @default(0)
  created_at  DateTime    @default(now())
  products    products    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  LiveSession LiveSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([session_id, product_id])
}

model live_tips {
  id           String     @id
  stream_id    String
  sender_id    String
  recipient_id String
  amount_kr    Decimal    @db.Decimal(18, 4)
  gift_type    String?
  message      String?
  created_at   DateTime   @default(now())
  LiveStream   LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@index([stream_id, created_at])
  @@index([stream_id, sender_id])
}

model live_viewers {
  id            String     @id
  stream_id     String
  user_id       String
  joined_at     DateTime   @default(now())
  left_at       DateTime?
  total_tips_kr Decimal    @default(0) @db.Decimal(18, 4)
  likes_given   Int        @default(0)
  LiveStream    LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@unique([stream_id, user_id])
  @@index([stream_id, total_tips_kr])
}

model location_master {
  id           String         @id
  scope        TargetingScope
  scope_value  String
  display_name String
  parent_id    String?
  continent    String?
  country      String?
  country_code String?        @db.VarChar(2)
  region       String?
  city         String?
  latitude     Decimal?       @db.Decimal(10, 7)
  longitude    Decimal?       @db.Decimal(10, 7)
  population   Int?
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now())

  @@unique([scope, scope_value])
  @@index([country_code])
  @@index([parent_id])
}

model logistics_companies {
  id             String          @id
  user_id        String          @unique
  company_name   String
  description    String?
  service_types  String[]
  coverage_areas String[]
  vehicle_types  String[]
  is_verified    Boolean         @default(false)
  created_at     DateTime        @default(now())
  User           User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shipping_jobs  shipping_jobs[]
}

model messages {
  id                                    String   @id
  sender_id                             String
  recipient_id                          String?
  chat_id                               String?
  text                                  String?
  media_url                             String?
  media_type                            String?
  forwarded_from_id                     String?
  is_read                               Boolean  @default(false)
  created_at                            DateTime @default(now())
  User_messages_forwarded_from_idToUser User?    @relation("messages_forwarded_from_idToUser", fields: [forwarded_from_id], references: [id])
  User_messages_sender_idToUser         User     @relation("messages_sender_idToUser", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([chat_id])
  @@index([created_at])
  @@index([recipient_id])
  @@index([sender_id])
}

model milestone_completions {
  id           String     @id
  milestone_id String     @unique
  user_id      String
  completed_at DateTime   @default(now())
  milestones   milestones @relation(fields: [milestone_id], references: [id])
  User         User       @relation(fields: [user_id], references: [id])
}

model milestones {
  id                    String                 @id
  title                 String
  description           String
  requirement_type      String
  requirement_value     Int
  reward_kr             Decimal                @db.Decimal(18, 4)
  contest_id            String?
  created_at            DateTime               @default(now())
  milestone_completions milestone_completions?
  Contest               Contest?               @relation(fields: [contest_id], references: [id], onDelete: Cascade)
}

model order_items {
  id             String    @id
  order_id       String
  product_id     String
  seller_id      String
  quantity       Int
  unit_price_kr  Decimal   @db.Decimal(18, 4)
  total_price_kr Decimal   @db.Decimal(18, 4)
  escrow_status  String    @default("held")
  delivered_at   DateTime?
  orders         orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  products       products  @relation(fields: [product_id], references: [id])
}

model orders {
  id              String        @id
  buyer_id        String
  total_kr        Decimal       @db.Decimal(18, 4)
  platform_fee_kr Decimal       @db.Decimal(18, 4)
  status          OrderStatus   @default(PENDING)
  notes           String?
  created_at      DateTime      @default(now())
  updated_at      DateTime
  order_items     order_items[]
  User            User          @relation(fields: [buyer_id], references: [id])

  @@index([buyer_id, status])
}

model platform_rate_limits {
  id                 String         @id
  platform           SocialPlatform @unique
  requests_per_hour  Int
  requests_remaining Int
  reset_at           DateTime
  last_request_at    DateTime?
  updated_at         DateTime
}

model post_comments {
  id         String   @id
  post_id    String
  user_id    String
  text       String
  created_at DateTime @default(now())
  Post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model post_likes {
  id         String   @id
  post_id    String
  user_id    String
  created_at DateTime @default(now())
  Post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
}

model premium_listings {
  id            String      @id
  product_id    String
  seller_id     String
  type          PremiumType
  daily_rate_kr Decimal     @db.Decimal(10, 2)
  total_paid_kr Decimal     @db.Decimal(18, 4)
  start_date    DateTime
  end_date      DateTime
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now())
  products      products    @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([is_active, end_date])
}

model product_analytics {
  id               String   @id
  product_id       String
  date             DateTime @db.Date
  views            Int      @default(0)
  clicks           Int      @default(0)
  add_to_cart      Int      @default(0)
  purchases        Int      @default(0)
  revenue          Decimal  @default(0) @db.Decimal(18, 4)
  conversion_rate  Decimal  @default(0) @db.Decimal(5, 4)
  avg_time_on_page Int      @default(0)
  bounce_rate      Decimal  @default(0) @db.Decimal(5, 4)
  products         products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, date])
}

model product_discounts {
  id             String   @id
  product_id     String
  discount_type  String
  discount_value Decimal  @db.Decimal(10, 2)
  min_quantity   Int      @default(1)
  start_date     DateTime
  end_date       DateTime
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  products       products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, is_active])
}

model product_reviews {
  id           String   @id
  product_id   String
  user_id      String
  rating       Int
  title        String?
  text         String?
  video_url    String?
  image_urls   String[]
  is_verified  Boolean  @default(false)
  is_moderated Boolean  @default(false)
  created_at   DateTime @default(now())
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([product_id, user_id])
  @@index([product_id, rating])
}

model product_shares {
  id           String   @id
  product_id   String
  user_id      String
  content_id   String?
  content_type String?
  caption      String?
  clicks       Int      @default(0)
  conversions  Int      @default(0)
  created_at   DateTime @default(now())
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model product_tags {
  id           String   @id
  product_id   String
  content_id   String
  content_type String
  position_x   Decimal? @db.Decimal(5, 2)
  position_y   Decimal? @db.Decimal(5, 2)
  timestamp    Int?
  clicks       Int      @default(0)
  created_at   DateTime @default(now())
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([content_id, content_type])
}

model products {
  id                      String                   @id
  seller_id               String
  title                   String
  description             String?
  image_urls              String[]
  price_kr                Decimal                  @db.Decimal(18, 4)
  whatsapp_number         String?
  status                  String                   @default("active")
  created_at              DateTime                 @default(now())
  avg_rating              Decimal                  @default(0) @db.Decimal(3, 2)
  bargain_enabled         Boolean                  @default(false)
  bargain_min_price       Decimal?                 @db.Decimal(18, 4)
  brand                   String?
  condition               ProductCondition         @default(NEW)
  contactMethod           ContactMethod            @default(WHATSAPP)
  currency                String?                  @db.VarChar(3)
  featured_until          DateTime?
  is_featured             Boolean                  @default(false)
  is_promoted             Boolean                  @default(false)
  is_top_spot             Boolean                  @default(false)
  latitude                Decimal?                 @db.Decimal(10, 7)
  local_price             Decimal?                 @db.Decimal(18, 4)
  location                String?
  longitude               Decimal?                 @db.Decimal(10, 7)
  promoted_until          DateTime?
  purchase_url            String?
  review_count            Int                      @default(0)
  sales_count             Int                      @default(0)
  stock                   Int                      @default(1)
  subcategory             String?
  tags                    String[]
  top_spot_until          DateTime?
  updated_at              DateTime
  view_count              Int                      @default(0)
  wholesale_min_qty       Int?
  wholesale_price         Decimal?                 @db.Decimal(18, 4)
  category                ProductCategory          @default(OTHER)
  book_details            book_details?
  cart_items              cart_items[]
  deal_alerts             deal_alerts[]
  digital_product_details digital_product_details?
  electronics_details     electronics_details?
  fashion_details         fashion_details?
  flash_sale_products     flash_sale_products[]
  food_details            food_details?
  group_buys              group_buys[]
  live_pinned_products    live_pinned_products[]
  live_session_products   live_session_products[]
  order_items             order_items[]
  premium_listings        premium_listings[]
  product_analytics       product_analytics[]
  product_discounts       product_discounts[]
  product_reviews         product_reviews[]
  product_shares          product_shares[]
  product_tags            product_tags[]
  User                    User                     @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  real_estate_details     real_estate_details?
  service_details         service_details?
  shoe_details            shoe_details?
  shorts                  shorts[]
  spare_part_details      spare_part_details?
  vehicle_details         vehicle_details?
  wishlist_items          wishlist_items[]

  @@index([category, status])
  @@index([seller_id, status])
  @@index([status, created_at])
}

model real_estate_details {
  id              String   @id
  product_id      String   @unique
  property_type   String
  listing_type    String
  land_size       String?
  bedrooms        Int?
  bathrooms       Int?
  floors          Int?
  year_built      Int?
  amenities       String[]
  legal_documents String[]
  furnished       Boolean  @default(false)
  parking         Boolean  @default(false)
  products        products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([property_type, listing_type])
}

model refresh_tokens {
  id         String   @id
  user_id    String
  token_hash String
  device_id  String
  expires_at DateTime
  created_at DateTime @default(now())
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model sales_funnel_events {
  id              String           @id
  user_id         String
  contest_id      String?
  campaign_id     String?
  stage           FunnelStage
  event_type      String
  source_type     String?
  source_id       String?
  metadata        Json?
  created_at      DateTime         @default(now())
  brand_campaigns brand_campaigns? @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  Contest         Contest?         @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, stage])
  @@index([contest_id, stage])
  @@index([created_at])
  @@index([user_id, stage])
}

model service_details {
  id                String   @id
  product_id        String   @unique
  service_type      String
  delivery_mode     String
  duration_minutes  Int?
  availability      String?
  revisions_allowed Int?
  turnaround_days   Int?
  products          products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model shipping_jobs {
  id                  String               @id
  requester_id        String
  logistics_id        String?
  pickup_location     String
  delivery_location   String
  job_type            String
  vehicle_desc        String?
  price_kr            Decimal?             @db.Decimal(18, 4)
  status              String               @default("open")
  created_at          DateTime             @default(now())
  logistics_companies logistics_companies? @relation(fields: [logistics_id], references: [id])
  User                User                 @relation(fields: [requester_id], references: [id])

  @@index([status])
}

model shoe_details {
  id              String   @id
  product_id      String   @unique
  shoe_size       String
  sole_material   String?
  heel_height     String?
  closure_type    String?
  water_resistant Boolean  @default(false)
  gender          String?
  products        products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model short_comments {
  id         String   @id
  short_id   String
  user_id    String
  text       String
  created_at DateTime @default(now())
  shorts     shorts   @relation(fields: [short_id], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model short_likes {
  id         String   @id
  short_id   String
  user_id    String
  created_at DateTime @default(now())
  shorts     shorts   @relation(fields: [short_id], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([short_id, user_id])
}

model shorts {
  id                String                @id
  user_id           String
  video_url         String
  thumbnail_url     String?
  caption           String?
  music_title       String?
  music_artist      String?
  is_locked         Boolean               @default(false)
  required_tier     SubscriptionTierType?
  contest_id        String?
  collection_id     String?
  linked_product_id String?
  views             Int                   @default(0)
  likes_count       Int                   @default(0)
  comments_count    Int                   @default(0)
  created_at        DateTime              @default(now())
  unlock_amount_kr  Decimal?              @db.Decimal(18, 4)
  short_comments    short_comments[]
  short_likes       short_likes[]
  ShortCollection   ShortCollection?      @relation(fields: [collection_id], references: [id])
  Contest           Contest?              @relation(fields: [contest_id], references: [id])
  products          products?             @relation(fields: [linked_product_id], references: [id])
  User              User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

model social_media_accounts {
  id                  String              @id
  influencer_id       String
  platform            SocialPlatform
  username            String
  profile_url         String
  display_name        String?
  follower_count      Int                 @default(0)
  subscriber_count    Int                 @default(0)
  video_count         Int                 @default(0)
  total_views         BigInt              @default(0)
  avg_views           Int                 @default(0)
  avg_likes           Int                 @default(0)
  engagement_rate     Decimal             @default(0) @db.Decimal(5, 2)
  is_verified         Boolean             @default(false)
  is_primary          Boolean             @default(false)
  last_synced_at      DateTime?
  sync_status         String              @default("pending")
  sync_error          String?
  access_token        String?
  refresh_token       String?
  token_expires_at    DateTime?
  created_at          DateTime            @default(now())
  updated_at          DateTime
  influencer_profiles influencer_profiles @relation(fields: [influencer_id], references: [id], onDelete: Cascade)

  @@unique([influencer_id, platform])
  @@index([influencer_id, is_primary])
  @@index([platform, follower_count])
}

model social_media_sync_logs {
  id               String   @id
  account_id       String
  sync_type        String
  status           String
  followers_before Int
  followers_after  Int
  follower_change  Int
  error_message    String?
  error_code       String?
  duration_ms      Int
  synced_at        DateTime @default(now())

  @@index([account_id, synced_at])
  @@index([status])
}

model platform_rate_limits {
  id                 String         @id
  platform           SocialPlatform @unique
  requests_per_hour  Int
  requests_remaining Int
  reset_at           DateTime
  last_request_at    DateTime?
  updated_at         DateTime
}

model spare_part_details {
  id                   String   @id
  product_id           String   @unique
  compatible_makes     String[]
  compatible_models    String[]
  compatible_year_from Int?
  compatible_year_to   Int?
  part_type            String
  part_number          String?
  oem_number           String?
  is_genuine           Boolean  @default(false)
  fits_left            Boolean  @default(false)
  fits_right           Boolean  @default(false)
  fits_front           Boolean  @default(false)
  fits_rear            Boolean  @default(false)
  products             products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([compatible_makes])
  @@index([part_type])
}

model sponsored_content {
  id                    String                  @id
  brand_user_id         String
  content_type          SponsoredContentType
  content_id            String
  campaign_name         String
  budget                Decimal                 @db.Decimal(18, 4)
  spent                 Decimal                 @default(0) @db.Decimal(18, 4)
  pricing_model         PricingModel
  bid_amount            Decimal                 @db.Decimal(18, 4)
  start_date            DateTime
  end_date              DateTime
  targeting             Json?
  status                SponsoredContentStatus  @default(PENDING_REVIEW)
  impressions           Int                     @default(0)
  views                 Int                     @default(0)
  engagements           Int                     @default(0)
  clicks                Int                     @default(0)
  escrow_id             String?
  created_at            DateTime                @default(now())
  updated_at            DateTime
  User                  User                    @relation(fields: [brand_user_id], references: [id], onDelete: Cascade)
  sponsored_impressions sponsored_impressions[]

  @@index([bid_amount])
  @@index([brand_user_id, status])
  @@index([content_type, status, start_date, end_date])
}

model sponsored_impressions {
  id                String            @id
  campaign_id       String
  user_id           String
  type              String
  cost              Decimal           @default(0) @db.Decimal(18, 4)
  created_at        DateTime          @default(now())
  sponsored_content sponsored_content @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  User              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, type])
  @@index([user_id, created_at])
}

model sponsored_post_requests {
  id                                            String              @id
  brand_id                                      String
  creator_id                                    String
  campaign_name                                 String
  description                                   String
  requirements                                  String
  total_payment_kes                             Decimal             @db.Decimal(18, 4)
  creator_payment_kes                           Decimal             @db.Decimal(18, 4)
  platform_fee_kes                              Decimal             @db.Decimal(18, 4)
  content_type                                  String
  content_id                                    String?
  content_url                                   String?
  status                                        SponsoredPostStatus @default(PENDING)
  rejection_reason                              String?
  verified_by                                   String?
  verified_at                                   DateTime?
  payment_released_at                           DateTime?
  created_at                                    DateTime            @default(now())
  updated_at                                    DateTime
  User_sponsored_post_requests_brand_idToUser   User                @relation("sponsored_post_requests_brand_idToUser", fields: [brand_id], references: [id], onDelete: Cascade)
  User_sponsored_post_requests_creator_idToUser User                @relation("sponsored_post_requests_creator_idToUser", fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([brand_id])
  @@index([creator_id])
  @@index([status])
}

model subscriptions {
  id                                     String               @id
  subscriber_id                          String
  creator_id                             String
  tier_id                                String
  tier                                   SubscriptionTierType
  kr_amount                              Decimal              @db.Decimal(18, 4)
  status                                 String               @default("active")
  started_at                             DateTime             @default(now())
  next_billing_at                        DateTime?
  cancelled_at                           DateTime?
  User_subscriptions_creator_idToUser    User                 @relation("subscriptions_creator_idToUser", fields: [creator_id], references: [id], onDelete: Cascade)
  User_subscriptions_subscriber_idToUser User                 @relation("subscriptions_subscriber_idToUser", fields: [subscriber_id], references: [id], onDelete: Cascade)
  SubscriptionTier                       SubscriptionTier     @relation(fields: [tier_id], references: [id])

  @@unique([subscriber_id, creator_id])
}

model team_chats {
  id         String   @id
  team_id    String   @unique
  chat_id    String
  created_at DateTime @default(now())
  Team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
}

model team_contest_registrations {
  id            String   @id
  contest_id    String
  team_id       String
  registered_at DateTime @default(now())
  Contest       Contest  @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  Team          Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, team_id])
  @@index([contest_id])
  @@index([team_id])
}

model team_invitations {
  id                                     String           @id
  team_id                                String
  inviter_id                             String
  invitee_id                             String
  status                                 InvitationStatus @default(PENDING)
  expires_at                             DateTime
  created_at                             DateTime         @default(now())
  User_team_invitations_invitee_idToUser User             @relation("team_invitations_invitee_idToUser", fields: [invitee_id], references: [id], onDelete: Cascade)
  User_team_invitations_inviter_idToUser User             @relation("team_invitations_inviter_idToUser", fields: [inviter_id], references: [id], onDelete: Cascade)
  Team                                   Team             @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([team_id, invitee_id, status])
  @@index([invitee_id, status])
  @@index([team_id, status])
}

model team_members {
  id        String   @id
  team_id   String
  user_id   String
  role      TeamRole @default(MEMBER)
  joined_at DateTime @default(now())
  Team      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([team_id])
  @@index([user_id])
}

model team_submission_votes {
  id               String           @id
  submission_id    String
  voter_id         String
  created_at       DateTime         @default(now())
  team_submissions team_submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  User             User             @relation(fields: [voter_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, voter_id])
  @@index([submission_id])
}

model team_submissions {
  id                    String                  @id
  contest_id            String
  team_id               String
  media_url             String
  media_type            String
  caption               String?
  contributors          String[]
  votes_count           Int                     @default(0)
  judge_score           Decimal?                @default(0) @db.Decimal(5, 2)
  final_score           Decimal?                @db.Decimal(7, 2)
  rank                  Int?
  submitted_at          DateTime                @default(now())
  team_submission_votes team_submission_votes[]
  Contest               Contest                 @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  Team                  Team                    @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, team_id])
  @@index([contest_id, votes_count])
}

model transactions {
  id              String   @id
  user_id         String
  type            String
  amount_kr       Decimal  @db.Decimal(18, 4)
  amount_fiat     Decimal? @db.Decimal(18, 4)
  currency        String?  @db.VarChar(3)
  provider        String?
  status          String   @default("pending")
  reference       String?
  counterparty_id String?
  metadata        Json?
  created_at      DateTime @default(now())
  User            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

model vehicle_details {
  id                String            @id
  product_id        String            @unique
  vehicle_type      String
  make              String
  model             String
  year              Int
  mileage           Int?
  fuel_type         FuelType?
  transmission      TransmissionType?
  body_type         VehicleBodyType?
  engine_size       String?
  color             String?
  vin               String?
  number_of_owners  Int?
  logbook_ready     Boolean           @default(false)
  import_status     String?
  import_cert_url   String?
  auction_sheet_url String?
  accident_history  Boolean           @default(false)
  trade_in_enabled  Boolean           @default(false)
  swap_enabled      Boolean           @default(false)
  products          products          @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([body_type])
  @@index([make, model])
  @@index([year])
}

model wallets {
  id         String   @id
  user_id    String   @unique
  kr_balance Decimal  @default(0) @db.Decimal(18, 4)
  created_at DateTime @default(now())
  updated_at DateTime
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model wishlist_items {
  id           String    @id
  wishlist_id  String
  product_id   String
  quantity     Int       @default(1)
  priority     Int       @default(0)
  notes        String?
  is_purchased Boolean   @default(false)
  added_at     DateTime  @default(now())
  products     products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  wishlists    wishlists @relation(fields: [wishlist_id], references: [id], onDelete: Cascade)

  @@unique([wishlist_id, product_id])
}

model wishlists {
  id             String           @id
  user_id        String
  name           String
  is_public      Boolean          @default(false)
  is_registry    Boolean          @default(false)
  event_type     String?
  event_date     DateTime?
  created_at     DateTime         @default(now())
  wishlist_items wishlist_items[]
  User           User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model notifications {
  id         String    @id
  user_id    String
  type       String
  title      String
  message    String    @db.Text
  data       Json?
  is_read    Boolean   @default(false)
  read_at    DateTime?
  created_at DateTime  @default(now())
  User       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@index([type])
}

model user_micro_interests {
  id           String   @id
  user_id      String
  interest     String
  weight       Decimal  @default(1.0) @db.Decimal(5, 2)
  last_updated DateTime @default(now())
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, interest])
  @@index([user_id])
}

model stories {
  id              String    @id
  user_id         String
  media_url       String
  media_type      String
  caption         String?
  duration_secs   Int       @default(15)
  views_count     Int       @default(0)
  likes_count     Int       @default(0)
  replies_count   Int       @default(0)
  is_highlighted  Boolean   @default(false)
  expires_at      DateTime
  created_at      DateTime  @default(now())
  User            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([expires_at])
}

model trending_topics {
  id             String   @id
  topic          String   @unique
  category       String?
  mention_count  Int      @default(0)
  engagement     Int      @default(0)
  trend_score    Decimal  @default(0) @db.Decimal(10, 2)
  is_active      Boolean  @default(true)
  last_updated   DateTime @default(now())
  created_at     DateTime @default(now())

  @@index([trend_score])
  @@index([is_active, trend_score])
}


  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  user                       user                         @relation(fields: [leader_id], references: [id], onDelete: Cascade)
  team_chats                 team_chats?
  team_contest_registrations team_contest_registrations[]
  team_invitations           team_invitations[]
  team_members               team_members[]
  team_submissions           team_submissions[]
}

model team_chats {
  id         String   @id
  team_id    String   @unique
  chat_id    String
  created_at DateTime @default(now())
  team       team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
}

model team_contest_registrations {
  id            String   @id
  contest_id    String
  team_id       String

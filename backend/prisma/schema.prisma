generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admire {
  id                              String   @id
  admirer_id                      String
  admired_id                      String
  is_lovers                       Boolean  @default(false)
  created_at                      DateTime @default(now())
  users_admires_admired_idTousers User     @relation("admires_admired_idTousers", fields: [admired_id], references: [id], onDelete: Cascade)
  users_admires_admirer_idTousers User     @relation("admires_admirer_idTousers", fields: [admirer_id], references: [id], onDelete: Cascade)

  @@unique([admirer_id, admired_id])
  @@map("admires")
}

model BioLink {
  id         String  @id
  user_id    String
  label      String
  url        String
  icon       String?
  sort_order Int     @default(0)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("bio_links")
}

model CommentLike {
  id         String   @id
  comment_id String
  user_id    String
  created_at DateTime @default(now())
  comments   Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([comment_id, user_id])
  @@index([comment_id])
  @@index([user_id])
  @@map("comment_likes")
}

model CommentReport {
  id          String   @id
  comment_id  String
  reporter_id String
  reason      String
  created_at  DateTime @default(now())
  comments    Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([comment_id])
  @@map("comment_reports")
}

model CommentSetting {
  id               String  @id
  content_id       String
  content_type     String
  comments_enabled Boolean @default(true)
  replies_enabled  Boolean @default(true)

  @@unique([content_id, content_type])
  @@map("comment_settings")
}

model Comment {
  id                                     String            @id
  user_id                                String
  content_id                             String
  content_type                           String
  text                                   String
  parent_id                              String?
  reply_to_user_id                       String?
  likes_count                            Int               @default(0)
  replies_count                          Int               @default(0)
  is_pinned                              Boolean           @default(false)
  is_edited                              Boolean           @default(false)
  created_at                             DateTime          @default(now())
  edited_at                              DateTime?
  comment_likes                          CommentLike[]
  comment_reports                        CommentReport[]
  comments                               Comment?          @relation("commentsTocomments", fields: [parent_id], references: [id], onDelete: Cascade)
  other_comments                         Comment[]         @relation("commentsTocomments")
  users_comments_reply_to_user_idTousers User?             @relation("comments_reply_to_user_idTousers", fields: [reply_to_user_id], references: [id])
  users_comments_user_idTousers          User              @relation("comments_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([content_type, content_id, created_at])
  @@index([is_pinned, created_at])
  @@index([parent_id])
  @@index([user_id])
  @@map("comments")
}

model ContestActionCompletion {
  id                  String              @id
  submission_id       String
  action_id           String
  is_completed        Boolean             @default(false)
  proof_url           String?
  ContestAction     ContestAction     @relation(fields: [action_id], references: [id], onDelete: Cascade)
  ContestSubmission ContestSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@map("contest_action_completions")
}

model ContestAction {
  id                         String                       @id
  contest_id                 String
  action_type                RequirementType
  target_url                 String?
  label                      String
  is_verifiable              Boolean                      @default(false)
  requires_upload            Boolean                      @default(false)
  sort_order                 Int                          @default(0)
  contest_action_completions ContestActionCompletion[]
  Contest                   Contest                     @relation(fields: [contest_id], references: [id], onDelete: Cascade)

  @@map("ContestAction")
}

model ContestJudge {
  id         String   @id
  contest_id String
  user_id    String
  status     String   @default("pending")
  added_at   DateTime @default(now())
  Contest   Contest @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, user_id])
  @@map("contest_judges")
}

model ContestParticipant {
  id         String   @id
  contest_id String
  user_id    String
  joined_at  DateTime @default(now())
  Contest   Contest @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, user_id])
  @@map("contest_participants")
}

model ContestPrizeDistribution {
  id         String   @id
  contest_id String
  rank       Int
  percentage Decimal  @db.Decimal(5, 2)
  Contest   Contest @relation(fields: [contest_id], references: [id], onDelete: Cascade)

  @@map("contest_prize_distributions")
}

model ContestSubmission {
  id                         String                       @id
  contest_id                 String
  user_id                    String
  media_url                  String
  media_type                 String
  proof_urls                 String[]
  votes_count                Int                          @default(0)
  judge_score                Decimal?                     @default(0) @db.Decimal(5, 2)
  final_score                Decimal?                     @db.Decimal(7, 2)
  rank                       Int?
  submitted_at               DateTime                     @default(now())
  contest_action_completions ContestActionCompletion[]
  Contest                   Contest                     @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User                      User                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contest_votes              ContestVote[]

  @@unique([contest_id, user_id])
  @@map("ContestSubmission")
}

model ContestVote {
  id                  String              @id
  submission_id       String
  voter_id            String
  ip_address          String?
  fingerprint         String?
  created_at          DateTime            @default(now())
  ContestSubmission ContestSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  User               User               @relation(fields: [voter_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, voter_id])
  @@map("contest_votes")
}

model ContestWinner {
  id         String   @id
  contest_id String
  user_id    String
  rank       Int
  prize_kr   Decimal  @db.Decimal(18, 4)
  awarded_at DateTime @default(now())
  Contest   Contest @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("contest_winners")
}

model Contest {
  id                          String                        @id
  creator_id                  String
  title                       String
  description                 String?
  media_type                  ContestMediaType
  category                    String
  cover_media_url             String?
  prize_total_kr              Decimal                       @db.Decimal(18, 4)
  platform_fee_kr             Decimal                       @db.Decimal(18, 4)
  participation_type          ParticipationType             @default(INDIVIDUAL_ONLY)
  team_size                   Int?
  max_teams                   Int?
  entry_fee_kr                Decimal?                      @db.Decimal(18, 4)
  public_vote_weight          Int?
  target_ages                 Int[]
  target_geos                 String[]
  airdrop_kr                  Decimal?                      @db.Decimal(18, 4)
  airdrop_limit               Int?
  allow_daily_prizes          Boolean                       @default(false)
  daily_prize_kr              Decimal?                      @db.Decimal(18, 4)
  max_winners                 Int                           @db.SmallInt
  judging_criteria            JudgingCriteria
  sponsor_name                String?
  sponsor_url                 String?
  deadline                    DateTime
  status                      ContestStatus                 @default(ACTIVE)
  total_participants          Int                           @default(0)
  total_submissions           Int                           @default(0)
  created_at                  DateTime                      @default(now())
  ContestAction             ContestAction[]
  contest_judges              ContestJudge[]
  contest_participants        ContestParticipant[]
  contest_prize_distributions ContestPrizeDistribution[]
  ContestSubmission         ContestSubmission[]
  contest_winners             ContestWinner[]
  User                       User                         @relation(fields: [creator_id], references: [id])
  escrows                     Escrow[]
  judge_invites               JudgeInvite[]
  milestones                  Milestone[]
  shorts                      Short[]
  team_contest_registrations  TeamContestRegistration[]
  team_submissions            TeamSubmission[]

  @@index([status, deadline])
  @@map("Contest")
}

model DailyStat {
  id           String   @id
  user_id      String
  date         DateTime @db.Date
  views        Int      @default(0)
  likes        Int      @default(0)
  new_admirers Int      @default(0)
  kr_earned    Decimal  @default(0) @db.Decimal(18, 4)
  kr_spent     Decimal  @default(0) @db.Decimal(18, 4)
  User        User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@map("daily_stats")
}

model Escrow {
  id              String   @id
  contest_id      String
  user_id         String
  prize_amount_kr Decimal  @db.Decimal(18, 4)
  fee_amount_kr   Decimal  @db.Decimal(18, 4)
  status          String   @default("held")
  created_at      DateTime @default(now())
  Contest        Contest @relation(fields: [contest_id], references: [id])
  User           User    @relation(fields: [user_id], references: [id])

  @@map("escrows")
}

model JudgeInvite {
  id           String            @id
  contest_id   String
  judge_id     String
  status       JudgeInviteStatus @default(PENDING)
  invited_at   DateTime          @default(now())
  responded_at DateTime?
  created_at   DateTime          @default(now())
  updated_at   DateTime
  Contest     Contest          @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User        User             @relation(fields: [judge_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, judge_id])
  @@index([contest_id])
  @@index([judge_id])
  @@index([status])
  @@map("judge_invites")
}

model LiveBannedViewer {
  id           String       @id
  stream_id    String
  user_id      String
  reason       String?
  banned_at    DateTime     @default(now())
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@unique([stream_id, user_id])
  @@map("live_banned_viewers")
}

model LiveBattle {
  id                                                         String       @id
  stream_id                                                  String
  opponent_stream_id                                         String
  contest_id                                                 String?
  duration_secs                                              Int          @default(300)
  status                                                     BattleStatus @default(PENDING)
  host_score                                                 Decimal      @default(0) @db.Decimal(18, 4)
  opponent_score                                             Decimal      @default(0) @db.Decimal(18, 4)
  winner_id                                                  String?
  started_at                                                 DateTime?
  ended_at                                                   DateTime?
  created_at                                                 DateTime     @default(now())
  live_streams_live_battles_opponent_stream_idTolive_streams LiveStream @relation("live_battles_opponent_stream_idTolive_streams", fields: [opponent_stream_id], references: [id], onDelete: Cascade)
  live_streams_live_battles_stream_idTolive_streams          LiveStream @relation("live_battles_stream_idTolive_streams", fields: [stream_id], references: [id], onDelete: Cascade)

  @@map("live_battles")
}

model LiveCoHost {
  id           String       @id
  stream_id    String
  user_id      String
  joined_at    DateTime     @default(now())
  left_at      DateTime?
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@unique([stream_id, user_id])
  @@map("live_co_hosts")
}

model LiveMessage {
  id           String       @id
  stream_id    String
  user_id      String
  text         String
  is_system    Boolean      @default(false)
  is_pinned    Boolean      @default(false)
  created_at   DateTime     @default(now())
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@index([stream_id, created_at])
  @@map("live_messages")
}

model LivePinnedProduct {
  id           String       @id
  stream_id    String
  product_id   String
  sale_price   Decimal?     @db.Decimal(18, 4)
  is_pinned    Boolean      @default(false)
  pinned_at    DateTime?
  units_sold   Int          @default(0)
  sort_order   Int          @default(0)
  Product     Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@unique([stream_id, product_id])
  @@map("live_pinned_products")
}

model LiveSessionProduct {
  id            String        @id
  session_id    String
  product_id    String
  sale_price    Decimal?      @db.Decimal(18, 4)
  units_sold    Int           @default(0)
  sort_order    Int           @default(0)
  created_at    DateTime      @default(now())
  Product      Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  LiveSession LiveSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([session_id, product_id])
  @@map("live_session_products")
}

model LiveSession {
  id                    String                  @id
  host_id               String
  title                 String
  description           String?
  scheduled_start       DateTime
  actual_start          DateTime?
  ended_at              DateTime?
  status                String                  @default("SCHEDULED")
  viewer_count          Int                     @default(0)
  peak_viewers          Int                     @default(0)
  total_sales_kr        Decimal                 @default(0) @db.Decimal(18, 4)
  created_at            DateTime                @default(now())
  live_session_products LiveSessionProduct[]
  User                 User                   @relation(fields: [host_id], references: [id], onDelete: Cascade)

  @@index([host_id, status])
  @@index([status, scheduled_start])
  @@map("LiveSession")
}

model LiveStream {
  id                                                         String                 @id
  host_id                                                    String
  title                                                      String
  description                                                String?
  category                                                   String?                @default("Chat") @db.VarChar(50)
  thumbnail_url                                              String?
  type                                                       LiveStreamType         @default(NORMAL)
  status                                                     LiveStreamStatus       @default(SCHEDULED)
  stream_key                                                 String                 @unique
  stream_url                                                 String?
  playback_url                                               String?
  viewer_count                                               Int                    @default(0)
  peak_viewers                                               Int                    @default(0)
  likes_count                                                Int                    @default(0)
  total_tips_kr                                              Decimal                @default(0) @db.Decimal(18, 4)
  total_sales_kr                                             Decimal                @default(0) @db.Decimal(18, 4)
  gift_goal_title                                            String?
  gift_goal_target                                           Decimal?               @db.Decimal(18, 4)
  gift_goal_current                                          Decimal                @default(0) @db.Decimal(18, 4)
  unlock_amount_kr                                           Decimal?               @db.Decimal(18, 4)
  chama_id                                                   String?
  contest_id                                                 String?
  order_id                                                   String?
  is_co_host_enabled                                         Boolean                @default(false)
  max_co_hosts                                               Int                    @default(1)
  scheduled_start                                            DateTime?
  actual_start                                               DateTime?
  ended_at                                                   DateTime?
  created_at                                                 DateTime               @default(now())
  live_banned_viewers                                        LiveBannedViewer[]
  live_battles_live_battles_opponent_stream_idTolive_streams LiveBattle[]         @relation("live_battles_opponent_stream_idTolive_streams")
  live_battles_live_battles_stream_idTolive_streams          LiveBattle[]         @relation("live_battles_stream_idTolive_streams")
  live_co_hosts                                              LiveCoHost[]
  live_messages                                              LiveMessage[]
  live_pinned_products                                       LivePinnedProduct[]
  User                                                      User                  @relation(fields: [host_id], references: [id], onDelete: Cascade)
  live_tips                                                  LiveTip[]
  live_viewers                                               LiveViewer[]

  @@index([category, status])
  @@index([host_id, status])
  @@index([status, created_at])
  @@index([status, viewer_count], map: "live_streams_status_viewers_idx")
  @@map("LiveStream")
}

model LiveTip {
  id           String       @id
  stream_id    String
  sender_id    String
  recipient_id String
  amount_kr    Decimal      @db.Decimal(18, 4)
  gift_type    String?
  message      String?
  created_at   DateTime     @default(now())
  LiveStream LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@index([stream_id, created_at])
  @@index([stream_id, sender_id])
  @@map("live_tips")
}

model LiveViewer {
  id            String       @id
  stream_id     String
  user_id       String
  joined_at     DateTime     @default(now())
  left_at       DateTime?
  total_tips_kr Decimal      @default(0) @db.Decimal(18, 4)
  likes_given   Int          @default(0)
  LiveStream  LiveStream @relation(fields: [stream_id], references: [id], onDelete: Cascade)

  @@unique([stream_id, user_id])
  @@index([stream_id, total_tips_kr])
  @@map("live_viewers")
}

model MilestoneCompletion {
  id           String     @id
  milestone_id String     @unique
  user_id      String
  completed_at DateTime   @default(now())
  milestones   Milestone  @relation(fields: [milestone_id], references: [id])
  User        User      @relation(fields: [user_id], references: [id])

  @@map("milestone_completions")
}

model Milestone {
  id                    String                 @id
  title                 String
  description           String
  requirement_type      String
  requirement_value     Int
  reward_kr             Decimal                @db.Decimal(18, 4)
  contest_id            String?
  created_at            DateTime               @default(now())
  milestone_completions MilestoneCompletion?
  Contest              Contest?              @relation(fields: [contest_id], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model PostComment {
  id         String   @id
  post_id    String
  user_id    String
  text       String
  created_at DateTime @default(now())
  Post      Post    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("post_comments")
}

model PostLike {
  id         String   @id
  post_id    String
  user_id    String
  created_at DateTime @default(now())
  Post      Post    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@map("post_likes")
}

model Post {
  id             String                @id
  user_id        String
  caption        String?
  image_urls     String[]
  is_locked      Boolean               @default(false)
  required_tier  SubscriptionTierType?
  likes_count    Int                   @default(0)
  comments_count Int                   @default(0)
  created_at     DateTime              @default(now())
  post_comments  PostComment[]
  post_likes     PostLike[]
  User          User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("Post")
}

model Product {
  id                    String                  @id
  seller_id             String
  title                 String
  description           String?
  image_urls            String[]
  price_kr              Decimal                 @db.Decimal(18, 4)
  category              String?
  whatsapp_number       String
  status                String                  @default("active")
  created_at            DateTime                @default(now())
  live_pinned_products  LivePinnedProduct[]
  live_session_products LiveSessionProduct[]
  User                 User                   @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  shorts                Short[]

  @@index([status, created_at])
  @@map("Product")
}

model RefreshToken {
  id         String   @id
  user_id    String
  token_hash String
  device_id  String
  expires_at DateTime
  created_at DateTime @default(now())
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ShortCollection {
  id         String   @id
  user_id    String
  name       String
  cover_url  String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shorts     Short[]

  @@map("ShortCollection")
}

model ShortComment {
  id         String   @id
  short_id   String
  user_id    String
  text       String
  created_at DateTime @default(now())
  shorts     Short    @relation(fields: [short_id], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("short_comments")
}

model ShortLike {
  id         String   @id
  short_id   String
  user_id    String
  created_at DateTime @default(now())
  shorts     Short    @relation(fields: [short_id], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([short_id, user_id])
  @@map("short_likes")
}

model Short {
  id                String                @id
  user_id           String
  video_url         String
  thumbnail_url     String?
  caption           String?
  music_title       String?
  music_artist      String?
  is_locked         Boolean               @default(false)
  required_tier     SubscriptionTierType?
  contest_id        String?
  collection_id     String?
  linked_product_id String?
  views             Int                   @default(0)
  likes_count       Int                   @default(0)
  comments_count    Int                   @default(0)
  created_at        DateTime              @default(now())
  short_comments    ShortComment[]
  short_likes       ShortLike[]
  ShortCollection ShortCollection?    @relation(fields: [collection_id], references: [id])
  Contest          Contest?             @relation(fields: [contest_id], references: [id])
  Product          Product?             @relation(fields: [linked_product_id], references: [id])
  User             User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("shorts")
}

model SubscriptionTier {
  id            String               @id
  creator_id    String
  tier          SubscriptionTierType
  kr_amount     Decimal              @db.Decimal(18, 4)
  benefits      String
  is_enabled    Boolean              @default(true)
  created_at    DateTime             @default(now())
  User         User                @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([creator_id, tier])
  @@map("SubscriptionTier")
}

model Subscription {
  id                                       String               @id
  subscriber_id                            String
  creator_id                               String
  tier_id                                  String
  tier                                     SubscriptionTierType
  kr_amount                                Decimal              @db.Decimal(18, 4)
  status                                   String               @default("active")
  started_at                               DateTime             @default(now())
  next_billing_at                          DateTime?
  cancelled_at                             DateTime?
  users_subscriptions_creator_idTousers    User                @relation("subscriptions_creator_idTousers", fields: [creator_id], references: [id], onDelete: Cascade)
  users_subscriptions_subscriber_idTousers User                @relation("subscriptions_subscriber_idTousers", fields: [subscriber_id], references: [id], onDelete: Cascade)
  SubscriptionTier                       SubscriptionTier   @relation(fields: [tier_id], references: [id])

  @@unique([subscriber_id, creator_id])
  @@map("subscriptions")
}

model TeamChat {
  id         String   @id
  team_id    String   @unique
  chat_id    String
  created_at DateTime @default(now())
  Team      Team    @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("team_chats")
}

model TeamContestRegistration {
  id            String   @id
  contest_id    String
  team_id       String
  registered_at DateTime @default(now())
  Contest      Contest @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  Team         Team    @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, team_id])
  @@index([contest_id])
  @@index([team_id])
  @@map("team_contest_registrations")
}

model TeamInvitation {
  id                                       String           @id
  team_id                                  String
  inviter_id                               String
  invitee_id                               String
  status                                   InvitationStatus @default(PENDING)
  expires_at                               DateTime
  created_at                               DateTime         @default(now())
  users_team_invitations_invitee_idTousers User            @relation("team_invitations_invitee_idTousers", fields: [invitee_id], references: [id], onDelete: Cascade)
  users_team_invitations_inviter_idTousers User            @relation("team_invitations_inviter_idTousers", fields: [inviter_id], references: [id], onDelete: Cascade)
  Team                                    Team            @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([team_id, invitee_id, status])
  @@index([invitee_id, status])
  @@index([team_id, status])
  @@map("team_invitations")
}

model TeamMember {
  id        String   @id
  team_id   String
  user_id   String
  role      TeamRole @default(MEMBER)
  joined_at DateTime @default(now())
  Team     Team    @relation(fields: [team_id], references: [id], onDelete: Cascade)
  User     User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([team_id])
  @@index([user_id])
  @@map("team_members")
}

model TeamSubmissionVote {
  id               String           @id
  submission_id    String
  voter_id         String
  created_at       DateTime         @default(now())
  team_submissions TeamSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  User            User            @relation(fields: [voter_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, voter_id])
  @@index([submission_id])
  @@map("team_submission_votes")
}

model TeamSubmission {
  id                    String                  @id
  contest_id            String
  team_id               String
  media_url             String
  media_type            String
  caption               String?
  contributors          String[]
  votes_count           Int                     @default(0)
  judge_score           Decimal?                @default(0) @db.Decimal(5, 2)
  final_score           Decimal?                @db.Decimal(7, 2)
  rank                  Int?
  submitted_at          DateTime                @default(now())
  team_submission_votes TeamSubmissionVote[]
  Contest              Contest                @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  Team                 Team                   @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([contest_id, team_id])
  @@index([contest_id, votes_count])
  @@map("team_submissions")
}

model Team {
  id                         String                       @id
  name                       String                       @unique @db.VarChar(50)
  avatar_url                 String?
  leader_id                  String
  max_members                Int                          @default(5)
  total_wins                 Int                          @default(0)
  total_prizes               Decimal                      @default(0) @db.Decimal(18, 4)
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  team_chats                 TeamChat?
  team_contest_registrations TeamContestRegistration[]
  team_invitations           TeamInvitation[]
  team_members               TeamMember[]
  team_submissions           TeamSubmission[]
  User                      User                        @relation(fields: [leader_id], references: [id], onDelete: Cascade)

  @@map("Team")
}

model Transaction {
  id              String   @id
  user_id         String
  type            String
  amount_kr       Decimal  @db.Decimal(18, 4)
  amount_fiat     Decimal? @db.Decimal(18, 4)
  currency        String?  @db.VarChar(3)
  provider        String?
  status          String   @default("pending")
  reference       String?
  counterparty_id String?
  metadata        Json?
  created_at      DateTime @default(now())
  User           User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("transactions")
}

model User {
  id                                                  String                  @id
  email                                               String                  @unique
  username                                            String                  @unique
  first_name                                          String
  last_name                                           String
  display_name                                        String
  avatar_url                                          String?
  cover_photo_url                                     String?
  bio                                                 String?
  country                                             String                  @db.VarChar(2)
  currency                                            String                  @db.VarChar(3)
  google_id                                           String?                 @unique
  apple_id                                            String?                 @unique
  account_type                                        AccountType             @default(CREATOR)
  is_admin                                            Boolean                 @default(false)
  is_verified                                         Boolean                 @default(false)
  is_wallet_unlocked                                  Boolean                 @default(false)
  wallet_pin_hash                                     String?
  password_hash                                       String?
  created_at                                          DateTime                @default(now())
  updated_at                                          DateTime
  admires_admires_admired_idTousers                   Admire[]               @relation("admires_admired_idTousers")
  admires_admires_admirer_idTousers                   Admire[]               @relation("admires_admirer_idTousers")
  bio_links                                           BioLink[]
  comment_likes                                       CommentLike[]
  comment_reports                                     CommentReport[]
  comments_comments_reply_to_user_idTousers           Comment[]              @relation("comments_reply_to_user_idTousers")
  comments_comments_user_idTousers                    Comment[]              @relation("comments_user_idTousers")
  contest_judges                                      ContestJudge[]
  contest_participants                                ContestParticipant[]
  ContestSubmission                                 ContestSubmission[]
  contest_votes                                       ContestVote[]
  contest_winners                                     ContestWinner[]
  Contest                                            Contest[]
  daily_stats                                         DailyStat[]
  escrows                                             Escrow[]
  judge_invites                                       JudgeInvite[]
  LiveSession                                       LiveSession[]
  LiveStream                                        LiveStream[]
  milestone_completions                               MilestoneCompletion[]
  post_comments                                       PostComment[]
  post_likes                                          PostLike[]
  Post                                               Post[]
  Product                                            Product[]
  refresh_tokens                                      RefreshToken[]
  ShortCollection                                   ShortCollection[]
  short_comments                                      ShortComment[]
  short_likes                                         ShortLike[]
  shorts                                              Short[]
  SubscriptionTier                                  SubscriptionTier[]
  subscriptions_subscriptions_creator_idTousers       Subscription[]         @relation("subscriptions_creator_idTousers")
  subscriptions_subscriptions_subscriber_idTousers    Subscription[]         @relation("subscriptions_subscriber_idTousers")
  team_invitations_team_invitations_invitee_idTousers TeamInvitation[]      @relation("team_invitations_invitee_idTousers")
  team_invitations_team_invitations_inviter_idTousers TeamInvitation[]      @relation("team_invitations_inviter_idTousers")
  team_members                                        TeamMember[]
  team_submission_votes                               TeamSubmissionVote[]
  Team                                               Team[]
  transactions                                        Transaction[]
  wallets                                             Wallet?

  @@map("User")
}

model Wallet {
  id         String   @id
  user_id    String   @unique
  kr_balance Decimal  @default(0) @db.Decimal(18, 4)
  created_at DateTime @default(now())
  updated_at DateTime
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("wallets")
}

enum AccountType {
  CREATOR
  BUSINESS
}

enum BattleStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum ContestMediaType {
  PHOTO
  VIDEO
  PHOTO_AND_VIDEO
}

enum ContestStatus {
  DRAFT
  ACTIVE
  JUDGING
  PENDING_PAYOUT
  COMPLETED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum JudgeInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum JudgingCriteria {
  CREATOR_PICKS
  COMMUNITY_VOTE
  MOST_ENGAGEMENT
  COMBINATION
}

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum LiveStreamType {
  NORMAL
  CHAMA
  CONTEST_BATTLE
  PROOF_OF_TASK
  COMMERCE
}

enum ParticipationType {
  INDIVIDUAL_ONLY
  TEAM_ONLY
  BOTH
}

enum RequirementType {
  FOLLOW_KRIETA
  YOUTUBE_SUB
  SPOTIFY_FOLLOW
  INSTAGRAM_FOLLOW
  TIKTOK_FOLLOW
  WATCH_VIDEO
  VISIT_SHOP
  CUSTOM
}

enum SubscriptionTierType {
  TOP_FUN
  REAL_FAN
  TRUE_FAN
  SUPER_FAN
}

enum TeamRole {
  LEADER
  CO_LEADER
  MEMBER
}

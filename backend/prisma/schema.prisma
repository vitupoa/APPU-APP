generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model ad_analytics {
  id                          String   @id
  date                        DateTime @unique @db.Date
  total_ad_spend_kes          Decimal  @default(0) @db.Decimal(18, 4)
  platform_revenue_kes        Decimal  @default(0) @db.Decimal(18, 4)
  creator_revenue_kes         Decimal  @default(0) @db.Decimal(18, 4)
  active_campaigns            Int      @default(0)
  total_impressions           Int      @default(0)
  total_clicks                Int      @default(0)
  total_conversions           Int      @default(0)
  native_impressions          Int      @default(0)
  banner_impressions          Int      @default(0)
  story_impressions           Int      @default(0)
  sponsored_posts_active      Int      @default(0)
  sponsored_posts_revenue_kes Decimal  @default(0) @db.Decimal(18, 4)
  created_at                  DateTime @default(now())

  @@index([date])
}

model ad_campaign_locations {
  id                   String               @id
  campaign_id          String
  scope                TargetingScope
  scope_value          String
  scope_display_name   String
  continent            String?
  country              String?
  region               String?
  city                 String?
  town                 String?
  road                 String?
  landmark             String?
  shopping_center      String?
  latitude             Decimal?             @db.Decimal(10, 7)
  longitude            Decimal?             @db.Decimal(10, 7)
  radius_km            Decimal?             @db.Decimal(6, 2)
  is_excluded          Boolean              @default(false)
  created_at           DateTime             @default(now())
  display_ad_campaigns display_ad_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id])
  @@index([scope, scope_value])
}

model ad_campaigns {
  id               String               @id
  brand_id         String
  campaign_name    String
  ad_type          AdType
  budget_kes       Decimal              @db.Decimal(18, 4)
  spent_kes        Decimal              @default(0) @db.Decimal(18, 4)
  cpm_bid          Decimal              @db.Decimal(10, 2)
  target_age_min   Int?
  target_age_max   Int?
  target_genders   String[]
  target_locations String[]
  target_interests String[]
  title            String
  description      String?
  image_url        String?
  cta_text         String?              @db.VarChar(50)
  cta_url          String?
  start_date       DateTime
  end_date         DateTime
  status           AdCampaignStatusType @default(PENDING)
  rejection_reason String?
  impressions      Int                  @default(0)
  clicks           Int                  @default(0)
  conversions      Int                  @default(0)
  approved_by      String?
  approved_at      DateTime?
  created_at       DateTime             @default(now())
  updated_at       DateTime
  user             user                 @relation(fields: [brand_id], references: [id], onDelete: Cascade)

  @@index([brand_id])
  @@index([start_date, end_date])
  @@index([status])
}

model ad_config {
  id                      String   @id
  platform_cut_percentage Decimal  @default(15.0) @db.Decimal(5, 2)
  native_ad_min_cpm       Decimal  @default(40.0) @db.Decimal(10, 2)
  native_ad_max_cpm       Decimal  @default(150.0) @db.Decimal(10, 2)
  native_ad_frequency     Int      @default(6)
  banner_ad_min_cpm       Decimal  @default(30.0) @db.Decimal(10, 2)
  banner_ad_max_cpm       Decimal  @default(100.0) @db.Decimal(10, 2)
  banner_ad_frequency     Int      @default(15)
  story_ad_min_cpm        Decimal  @default(80.0) @db.Decimal(10, 2)
  story_ad_max_cpm        Decimal  @default(200.0) @db.Decimal(10, 2)
  story_ad_frequency      Int      @default(20)
  ads_enabled             Boolean  @default(true)
  max_ad_load_enabled     Boolean  @default(false)
  updated_by              String?
  created_at              DateTime @default(now())
  updated_at              DateTime
}

model ad_impressions {
  id               String        @id
  campaign_id      String
  user_id          String
  placement        PlacementType
  content_id       String?
  content_type     String?
  chat_id          String?
  chat_niche       ChatNiche?
  was_clicked      Boolean       @default(false)
  was_converted    Boolean       @default(false)
  view_duration_ms Int           @default(0)
  cost_kes         Decimal       @db.Decimal(10, 4)
  user_country     String?
  user_city        String?
  created_at       DateTime      @default(now())
  content_niche    String?

  @@index([campaign_id, user_id])
  @@index([placement, created_at])
  @@index([user_id, created_at])
}

model ad_platform_settings {
  id                      String         @id
  scope                   TargetingScope
  scope_value             String?
  min_daily_budget_kes    Decimal        @db.Decimal(18, 4)
  min_lifetime_budget_kes Decimal        @db.Decimal(18, 4)
  contest_min_cpm         Decimal        @db.Decimal(10, 2)
  contest_max_cpm         Decimal        @db.Decimal(10, 2)
  discover_min_cpm        Decimal        @db.Decimal(10, 2)
  discover_max_cpm        Decimal        @db.Decimal(10, 2)
  admiring_min_cpm        Decimal        @db.Decimal(10, 2)
  admiring_max_cpm        Decimal        @db.Decimal(10, 2)
  drips_min_cpm           Decimal        @db.Decimal(10, 2)
  drips_max_cpm           Decimal        @db.Decimal(10, 2)
  stories_min_cpm         Decimal        @db.Decimal(10, 2)
  stories_max_cpm         Decimal        @db.Decimal(10, 2)
  group_chat_min_cpm      Decimal        @db.Decimal(10, 2)
  group_chat_max_cpm      Decimal        @db.Decimal(10, 2)
  targeting_multiplier    Decimal        @default(1.0) @db.Decimal(3, 2)
  priority                Int            @default(0)
  is_active               Boolean        @default(true)
  created_by              String?
  updated_by              String?
  created_at              DateTime       @default(now())
  updated_at              DateTime

  @@unique([scope, scope_value])
  @@index([scope, priority])
}

model admin_profile {
  id            String    @id
  user_id       String    @unique
  role          AdminRole @default(ADMIN)
  created_at    DateTime  @default(now())
  updated_at    DateTime
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  granted_by    String?
  permissions   Json?
  user          user      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model admires {
  id                            String   @id
  admirer_id                    String
  admired_id                    String
  is_lovers                     Boolean  @default(false)
  created_at                    DateTime @default(now())
  user_admires_admired_idTouser user     @relation("admires_admired_idTouser", fields: [admired_id], references: [id], onDelete: Cascade)
  user_admires_admirer_idTouser user     @relation("admires_admirer_idTouser", fields: [admirer_id], references: [id], onDelete: Cascade)

  @@unique([admirer_id, admired_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id             String   @id
  ip_address     String?
  user_agent     String?
  created_at     DateTime @default(now())
  action_details Json
  action_type    String
  performed_by   String
  target_user_id String?

  @@index([action_type])
  @@index([created_at])
  @@index([performed_by])
  @@index([target_user_id])
  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([performed_by], map: "idx_audit_logs_performed_by")
  @@index([target_user_id], map: "idx_audit_logs_target_user_id")
}

model bio_links {
  id         String  @id
  user_id    String
  label      String
  url        String
  icon       String?
  sort_order Int     @default(0)
  user       user    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model book_details {
  id           String   @id
  product_id   String   @unique
  author       String
  isbn         String?
  publisher    String?
  edition      String?
  language     String?
  page_count   Int?
  genre        String?
  downloadable Boolean  @default(false)
  download_url String?
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model brand_campaigns {
  id                          String                  @id
  brand_id                    String
  title                       String
  description                 String
  type                        CampaignType
  status                      CampaignStatus          @default(DRAFT)
  target_tiers                InfluencerTier[]
  target_categories           String[]
  min_followers               Int?
  min_engagement_rate         Decimal?                @db.Decimal(5, 2)
  target_geos                 String[]
  budget_kr                   Decimal                 @db.Decimal(18, 4)
  compensation_per_influencer Decimal                 @db.Decimal(18, 4)
  max_influencers             Int
  required_posts              Int                     @default(0)
  required_videos             Int                     @default(0)
  required_stories            Int                     @default(0)
  content_guidelines          String?
  hashtags                    String[]
  mentions                    String[]
  contest_id                  String?
  application_deadline        DateTime?
  campaign_start_date         DateTime
  campaign_end_date           DateTime
  total_applications          Int                     @default(0)
  accepted_influencers        Int                     @default(0)
  total_reach                 Int                     @default(0)
  total_engagement            Int                     @default(0)
  total_conversions           Int                     @default(0)
  total_revenue_kr            Decimal                 @default(0) @db.Decimal(18, 4)
  roi                         Decimal                 @default(0) @db.Decimal(10, 2)
  created_at                  DateTime                @default(now())
  updated_at                  DateTime
  user                        user                    @relation(fields: [brand_id], references: [id])
  contest                     contest?                @relation(fields: [contest_id], references: [id])
  campaign_analytics          campaign_analytics[]
  campaign_applications       campaign_applications[]
  campaign_deliverables       campaign_deliverables[]
  sales_funnel_events         sales_funnel_events[]

  @@index([brand_id])
  @@index([contest_id])
  @@index([status, campaign_start_date])
}

model campaign_analytics {
  id              String          @id
  campaign_id     String
  date            DateTime        @db.Date
  impressions     Int             @default(0)
  reach           Int             @default(0)
  engagement      Int             @default(0)
  clicks          Int             @default(0)
  conversions     Int             @default(0)
  revenue         Decimal         @default(0) @db.Decimal(18, 4)
  spent_kr        Decimal         @default(0) @db.Decimal(18, 4)
  ctr             Decimal         @default(0) @db.Decimal(5, 4)
  conversion_rate Decimal         @default(0) @db.Decimal(5, 4)
  cpa             Decimal         @default(0) @db.Decimal(18, 4)
  roas            Decimal         @default(0) @db.Decimal(10, 2)
  brand_campaigns brand_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, date])
  @@index([date])
}

model campaign_applications {
  id                  String              @id
  campaign_id         String
  influencer_id       String
  status              ApplicationStatus   @default(PENDING)
  pitch               String
  proposed_rate       Decimal?            @db.Decimal(18, 4)
  availability        String?
  response_note       String?
  responded_at        DateTime?
  applied_at          DateTime            @default(now())
  brand_campaigns     brand_campaigns     @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  influencer_profiles influencer_profiles @relation(fields: [influencer_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, influencer_id])
  @@index([influencer_id, status])
}

model campaign_deliverables {
  id                  String              @id
  campaign_id         String
  influencer_id       String
  type                String
  platform            String
  content_url         String
  caption             String?
  views               Int                 @default(0)
  likes               Int                 @default(0)
  comments            Int                 @default(0)
  shares              Int                 @default(0)
  clicks              Int                 @default(0)
  conversions         Int                 @default(0)
  status              DeliverableStatus   @default(PENDING)
  review_note         String?
  reviewed_at         DateTime?
  submitted_at        DateTime            @default(now())
  brand_campaigns     brand_campaigns     @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  influencer_profiles influencer_profiles @relation(fields: [influencer_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, status])
  @@index([influencer_id])
}

model cart_items {
  id            String   @id
  user_id       String
  product_id    String
  quantity      Int      @default(1)
  bargain_price Decimal? @db.Decimal(18, 4)
  added_at      DateTime @default(now())
  products      products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user          user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
}

model chat {
  id               String             @id
  type             ChatType
  name             String?
  description      String?
  avatar_url       String?
  created_at       DateTime           @default(now())
  updated_at       DateTime
  chat_participant chat_participant[]
  messages         messages[]
}

model chat_participant {
  id         String   @id
  chat_id    String
  user_id    String
  role       String   @default("member")
  lastRead   DateTime @default(now())
  created_at DateTime @default(now())
  chat       chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chat_id, user_id])
  @@index([chat_id])
  @@index([user_id])
}

model chat_task_unlocks {
  id               String         @id
  user_id          String
  creator_id       String
  amount_kr        Decimal        @db.Decimal(18, 4)
  task_description String
  status           ChatTaskStatus @default(PENDING)
  deadline         DateTime
  deliverable_url  String?
  created_at       DateTime       @default(now())
  completed_at     DateTime?

  @@index([creator_id])
  @@index([status])
  @@index([user_id, creator_id])
  @@index([user_id])
}

model comment_likes {
  id         String   @id
  comment_id String
  user_id    String
  created_at DateTime @default(now())
  comments   comments @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([comment_id, user_id])
  @@index([comment_id])
  @@index([user_id])
}

model comment_reports {
  id          String   @id
  comment_id  String
  reporter_id String
  reason      String
  created_at  DateTime @default(now())
  comments    comments @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user        user     @relation(fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([comment_id])
}

model comment_settings {
  id               String  @id
  content_id       String
  content_type     String
  comments_enabled Boolean @default(true)
  replies_enabled  Boolean @default(true)

  @@unique([content_id, content_type])
}

model comments {
  id                                   String            @id
  user_id                              String
  content_id                           String
  content_type                         String
  text                                 String
  parent_id                            String?
  reply_to_user_id                     String?
  likes_count                          Int               @default(0)
  replies_count                        Int               @default(0)
  is_pinned                            Boolean           @default(false)
  is_edited                            Boolean           @default(false)
  created_at                           DateTime          @default(now())
  edited_at                            DateTime?
  comment_likes                        comment_likes[]
  comment_reports                      comment_reports[]
  comments                             comments?         @relation("commentsTocomments", fields: [parent_id], references: [id], onDelete: Cascade)
  other_comments                       comments[]        @relation("commentsTocomments")
  user_comments_reply_to_user_idTouser user?             @relation("comments_reply_to_user_idTouser", fields: [reply_to_user_id], references: [id])
  user_comments_user_idTouser          user              @relation("comments_user_idTouser", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([content_type, content_id, created_at])
  @@index([is_pinned, created_at])
  @@index([parent_id])
  @@index([user_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model compliance_reviews {
  id             String    @id
  transaction_id String
  user_id        String
  reviewer_id    String?
  review_type    String
  status         String    @default("PENDING")
  decision       String?
  notes          String?
  created_at     DateTime  @default(now())
  reviewed_at    DateTime?

  @@index([created_at])
  @@index([reviewer_id])
  @@index([status])
  @@index([transaction_id])
  @@index([user_id])
  @@index([created_at], map: "idx_compliance_reviews_created_at")
  @@index([reviewer_id], map: "idx_compliance_reviews_reviewer_id")
  @@index([status], map: "idx_compliance_reviews_status")
  @@index([user_id], map: "idx_compliance_reviews_user_id")
}

model content_distribution {
  id                   String    @id
  content_id           String
  content_type         String
  distribution_tier    String    @default("TEST")
  target_audience_size Int       @default(0)
  completion_rate      Decimal?  @db.Decimal(5, 4)
  like_rate            Decimal?  @db.Decimal(5, 4)
  share_rate           Decimal?  @db.Decimal(5, 4)
  comment_rate         Decimal?  @db.Decimal(5, 4)
  rewatch_rate         Decimal?  @db.Decimal(5, 4)
  engagement_score     Decimal?  @db.Decimal(5, 4)
  should_amplify       Boolean   @default(false)
  last_evaluated_at    DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime

  @@unique([content_id, content_type])
  @@index([content_id, content_type])
}

model content_hashtag {
  id          String   @id
  hashtagId   String
  content_id  String
  contentType String
  created_at  DateTime @default(now())
  hashtag     hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([hashtagId, content_id, contentType])
  @@index([content_id, contentType])
  @@index([hashtagId])
}

model content_mention {
  id              String   @id
  mentionedUserId String
  content_id      String
  contentType     String
  created_at      DateTime @default(now())
  user            user     @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([mentionedUserId, content_id, contentType])
  @@index([content_id, contentType])
  @@index([mentionedUserId])
}

model content_moderation_logs {
  id          String   @id
  adminId     String
  contentType String
  content_id  String
  action      String
  reason      String?
  created_at  DateTime @default(now())

  @@index([adminId])
  @@index([contentType, content_id])
}

model content_niche_tags {
  id          String   @id
  content_id  String
  contentType String
  niche       String
  created_at  DateTime @default(now())
  confidence  Decimal  @default(1.0) @db.Decimal(3, 2)

  @@unique([content_id, contentType, niche])
  @@index([content_id, contentType])
  @@index([niche])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model content_unlocks {
  id                                    String   @id
  user_id                               String
  content_id                            String
  content_type                          String
  amount_kr                             Decimal  @db.Decimal(18, 4)
  amount_fiat                           Decimal? @db.Decimal(18, 4)
  currency                              String?  @db.VarChar(3)
  creator_id                            String
  created_at                            DateTime @default(now())
  user_content_unlocks_creator_idTouser user     @relation("content_unlocks_creator_idTouser", fields: [creator_id], references: [id], onDelete: Cascade)
  user_content_unlocks_user_idTouser    user     @relation("content_unlocks_user_idTouser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, content_id, content_type])
  @@index([content_id, content_type])
  @@index([creator_id])
  @@index([user_id])
}

model contest {
  id                          String                        @id
  creator_id                  String
  title                       String
  description                 String?
  media_type                  ContestMediaType
  category                    String
  cover_media_url             String?
  prize_total_kr              Decimal                       @db.Decimal(18, 4)
  platform_fee_kr             Decimal                       @db.Decimal(18, 4)
  participation_type          ParticipationType             @default(INDIVIDUAL_ONLY)
  team_size                   Int?
  max_teams                   Int?
  entry_fee_kr                Decimal?                      @db.Decimal(18, 4)
  public_vote_weight          Int?
  target_ages                 Int[]
  target_geos                 String[]
  airdrop_kr                  Decimal?                      @db.Decimal(18, 4)
  airdrop_limit               Int?
  allow_daily_prizes          Boolean                       @default(false)
  daily_prize_kr              Decimal?                      @db.Decimal(18, 4)
  max_winners                 Int                           @db.SmallInt
  judging_criteria            JudgingCriteria
  sponsor_name                String?
  sponsor_url                 String?
  deadline                    DateTime
  status                      ContestStatus                 @default(ACTIVE)
  total_participants          Int                           @default(0)
  total_submissions           Int                           @default(0)
  created_at                  DateTime                      @default(now())
  is_legal_structure          Boolean                       @default(true)
  is_voting_paid              Boolean                       @default(false)
  judge_weight_percentage     Int?
  judging_method              JudgingMethod?
  validation_errors           String[]                      @default([])
  vote_weight_percentage      Int?
  voting_cost_per_vote_kr     Decimal?                      @db.Decimal(18, 4)
  voting_enabled              Boolean                       @default(true)
  brand_campaigns             brand_campaigns[]
  user                        user                          @relation(fields: [creator_id], references: [id])
  contest_action              contest_action[]
  contest_analytics           contest_analytics[]
  contest_engagement_actions  contest_engagement_actions[]
  contest_judges              contest_judges[]
  contest_participants        contest_participants[]
  contest_prize_distributions contest_prize_distributions[]
  contest_purchase_entries    contest_purchase_entries[]
  contest_sponsorships        contest_sponsorships[]
  contest_submission          contest_submission[]
  contest_winners             contest_winners[]
  conversion_campaigns        conversion_campaigns[]
  escrows                     escrows[]
  judge_invites               judge_invites[]
  milestones                  milestones[]
  sales_funnel_events         sales_funnel_events[]
  shorts                      shorts[]
  team_contest_registrations  team_contest_registrations[]
  team_submissions            team_submissions[]

  @@index([is_legal_structure])
  @@index([status, deadline])
}

model contest_action {
  id                         String                       @id
  contest_id                 String
  action_type                RequirementType
  target_url                 String?
  label                      String
  is_verifiable              Boolean                      @default(false)
  requires_upload            Boolean                      @default(false)
  sort_order                 Int                          @default(0)
  contest                    contest                      @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  contest_action_completions contest_action_completions[]
}

model contest_action_completions {
  id                 String             @id
  submission_id      String
  action_id          String
  is_completed       Boolean            @default(false)
  proof_url          String?
  contest_action     contest_action     @relation(fields: [action_id], references: [id], onDelete: Cascade)
  contest_submission contest_submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
}

model contest_analytics {
  id              String   @id
  contest_id      String
  date            DateTime @db.Date
  views           Int      @default(0)
  joins           Int      @default(0)
  submissions     Int      @default(0)
  votes           Int      @default(0)
  shares          Int      @default(0)
  shop_visits     Int      @default(0)
  product_views   Int      @default(0)
  add_to_carts    Int      @default(0)
  purchases       Int      @default(0)
  revenue         Decimal  @default(0) @db.Decimal(18, 4)
  join_rate       Decimal  @default(0) @db.Decimal(5, 4)

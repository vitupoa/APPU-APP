model stories {
  id             String   @id
  user_id        String
  media_url      String
  media_type     String
  caption        String?
  duration_secs  Int      @default(15)
  views_count    Int      @default(0)
  likes_count    Int      @default(0)
  replies_count  Int      @default(0)
  is_highlighted Boolean  @default(false)
  expires_at     DateTime
  created_at     DateTime @default(now())
  user           user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([user_id, created_at])
}

model story {
  id         String       @id
  creator_id String
  media_url  String
  media_type String
  text       String?
  privacy    StoryPrivacy @default(PUBLIC)
  expires_at DateTime
  created_at DateTime     @default(now())
  user       user         @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  story_view story_view[]

  @@index([creator_id, created_at])
  @@index([expires_at])
}

model story_view {
  id         String   @id
  storyId    String
  viewerId   String
  viewedAt   DateTime @default(now())
  isTipped   Boolean  @default(false)
  tip_amount Decimal? @db.Decimal(18, 4)
  story      story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@index([viewerId])
}

model story_viewer_preference {
  id                String   @id
  ownerId           String
  preferredViewerId String
  created_at        DateTime @default(now())
  user              user     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, preferredViewerId])
  @@index([ownerId])
}

model subscription_tier {
  id            String               @id
  creator_id    String
  tier          SubscriptionTierType
  kr_amount     Decimal              @db.Decimal(18, 4)
  benefits      String
  is_enabled    Boolean              @default(true)
  created_at    DateTime             @default(now())
  user          user                 @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  subscriptions subscriptions[]

  @@unique([creator_id, tier])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subscriptions {
  id                                     String               @id
  subscriber_id                          String
  creator_id                             String
  tier_id                                String
  tier                                   SubscriptionTierType
  kr_amount                              Decimal              @db.Decimal(18, 4)
  status                                 String               @default("active")
  started_at                             DateTime             @default(now())
  next_billing_at                        DateTime?
  cancelled_at                           DateTime?
  user_subscriptions_creator_idTouser    user                 @relation("subscriptions_creator_idTouser", fields: [creator_id], references: [id], onDelete: Cascade)
  user_subscriptions_subscriber_idTouser user                 @relation("subscriptions_subscriber_idTouser", fields: [subscriber_id], references: [id], onDelete: Cascade)
  subscription_tier                      subscription_tier    @relation(fields: [tier_id], references: [id])

  @@unique([subscriber_id, creator_id])
}

model suspicious_activities {
  id              String    @id
  user_id         String
  activity_type   String
  description     String
  severity        String
  ip_address      String?
  user_agent      String?
  metadata        Json?
  resolved        Boolean   @default(false)
  resolved_by     String?
  resolved_at     DateTime?
  created_at      DateTime  @default(now())
  resolution_note String?

  @@index([resolved])
  @@index([severity])
  @@index([user_id])
}

model suspicious_activity_logs {
  id           String    @id
  user_id      String
  activityType String
  description  String
  severity     String
  metadata     Json?
  resolved     Boolean   @default(false)
  resolved_by  String?
  resolved_at  DateTime?

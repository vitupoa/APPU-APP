generator client {
  provider      = "prisma-client-js"
  fieldMapping  = "camelCase"
}

datasource db {
  provider = "postgresql"
}

model Contest {
  id                          String                        @id @default(uuid())
  creator_id                  String
  title                       String
  description                 String?
  media_type                  ContestMediaType
  category                    String
  cover_media_url             String?
  prize_total_kr              Decimal                       @db.Decimal(18, 4)
  platform_fee_kr             Decimal                       @db.Decimal(18, 4)
  participation_type          ParticipationType             @default(INDIVIDUAL_ONLY)
  team_size                   Int?
  max_teams                   Int?
  entry_fee_kr                Decimal?                      @db.Decimal(18, 4)
  public_vote_weight          Int?
  target_ages                 Int[]
  target_geos                 String[]
  airdrop_kr                  Decimal?                      @db.Decimal(18, 4)
  airdrop_limit               Int?
  allow_daily_prizes          Boolean                       @default(false)
  daily_prize_kr              Decimal?                      @db.Decimal(18, 4)
  max_winners                 Int                           @db.SmallInt
  judging_criteria            JudgingCriteria
  sponsor_name                String?
  sponsor_url                 String?
  deadline                    DateTime
  status                      ContestStatus                 @default(ACTIVE)
  total_participants          Int                           @default(0)
  total_submissions           Int                           @default(0)
  created_at                  DateTime                      @default(now())
  User                        User                          @relation(fields: [creator_id], references: [id])
  ContestAction               ContestAction[]
  ContestSubmission           ContestSubmission[]
  brand_campaigns             brand_campaigns[]
  contest_analytics           contest_analytics[]
  contest_engagement_actions  contest_engagement_actions[]
  contest_judges              contest_judges[]
  contest_participants        contest_participants[]
  contest_prize_distributions contest_prize_distributions[]
  contest_purchase_entries    contest_purchase_entries[]
  contest_sponsorships        contest_sponsorships[]
  contest_winners             contest_winners[]
  conversion_campaigns        conversion_campaigns[]
  escrows                     escrows[]
  judge_invites               judge_invites[]
  milestones                  milestones[]
  sales_funnel_events         sales_funnel_events[]
  shorts                      shorts[]
  team_contest_registrations  team_contest_registrations[]
  team_submissions            team_submissions[]

  @@index([status, deadline])
  @@map("contest")
}

model ContestAction {
  id                         String                       @id @default(uuid())
  contest_id                 String
  action_type                RequirementType
  target_url                 String?
  label                      String
  is_verifiable              Boolean                      @default(false)
  requires_upload            Boolean                      @default(false)
  sort_order                 Int                          @default(0)
  Contest                    Contest                      @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  contest_action_completions contest_action_completions[]

  @@map("contest_action")
}

model ContestSubmission {
  id                         String                       @id @default(uuid())
  contest_id                 String
  user_id                    String
  media_url                  String
  media_type                 String
  proof_urls                 String[]
  votes_count                Int                          @default(0)
  judge_score                Decimal?                     @default(0) @db.Decimal(5, 2)
  final_score                Decimal?                     @db.Decimal(7, 2)
  rank                       Int?
  submitted_at               DateTime                     @default(now())
  Contest                    Contest                      @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User                       User                         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contest_action_completions contest_action_completions[]
  contest_votes              contest_votes[]

  @@unique([contest_id, user_id])
  @@map("contest_submission")
}

model Post {
  id               String                @id @default(uuid())
  user_id          String
  caption          String?
  image_urls       String[]
  is_locked        Boolean               @default(false)
  required_tier    SubscriptionTierType?
  likes_count      Int                   @default(0)
  comments_count   Int                   @default(0)
  created_at       DateTime              @default(now())
  unlock_amount_kr Decimal?              @db.Decimal(18, 4)
  User             User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_comments    post_comments[]
  post_likes       post_likes[]

  @@index([user_id, created_at])
  @@map("post")
}

model ShortCollection {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  cover_url  String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shorts     shorts[]

  @@map("short_collection")
}

model SubscriptionTier {
  id            String               @id @default(uuid())
  creator_id    String
  tier          SubscriptionTierType
  kr_amount     Decimal              @db.Decimal(18, 4)
  benefits      String
  is_enabled    Boolean              @default(true)
  created_at    DateTime             @default(now())
  User          User                 @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  subscriptions subscriptions[]

  @@unique([creator_id, tier])
  @@map("subscription_tier")
}

model Team {
  id                         String                       @id @default(uuid())
  name                       String                       @unique @db.VarChar(50)
  avatar_url                 String?
  leader_id                  String
  max_members                Int                          @default(5)
  total_wins                 Int                          @default(0)
  total_prizes               Decimal                      @default(0) @db.Decimal(18, 4)
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  User                       User                         @relation(fields: [leader_id], references: [id], onDelete: Cascade)
  team_chats                 team_chats?
  team_contest_registrations team_contest_registrations[]
  team_invitations           team_invitations[]
  team_members               team_members[]
  team_submissions           team_submissions[]

  @@map("team")
}

model User {
  id                                                               String                           @id @default(uuid())
  email                                                            String                           @unique
  username                                                         String                           @unique
  first_name                                                       String
  last_name                                                        String
  display_name                                                     String
  avatar_url                                                       String?
  cover_photo_url                                                  String?
  bio                                                              String?
  country                                                          String                           @db.VarChar(2)
  currency                                                         String                           @db.VarChar(3)
  google_id                                                        String?                          @unique
  apple_id                                                         String?                          @unique
  account_type                                                     AccountType                      @default(CREATOR)
  is_admin                                                         Boolean                          @default(false)
  is_verified                                                      Boolean                          @default(false)
  is_wallet_unlocked                                               Boolean                          @default(false)
  wallet_pin_hash                                                  String?
  password_hash                                                    String?
  isRotationLocked                                                 Boolean                          @default(false)
  isSuspended                                                      Boolean                          @default(false)
  suspendedAt                                                      DateTime?
  created_at                                                       DateTime                         @default(now())
  updated_at                                                       DateTime
  devicePlatform                                                   String?
  fcmToken                                                         String?
  selectedNiches                                                   String[]                         @default([])
  customNiches                                                     String[]                         @default([])
  admirers_count                                                   Int                              @default(0)
  kyc_status                                                       KYCStatus                        @default(NOT_STARTED)
  Contest                                                          Contest[]
  ContestSubmission                                                ContestSubmission[]
  Post                                                             Post[]
  ShortCollection                                                  ShortCollection[]
  SubscriptionTier                                                 SubscriptionTier[]
  Team                                                             Team[]
  ad_campaigns                                                     ad_campaigns[]
  admires_admires_admired_idToUser                                 admires[]                        @relation("admires_admired_idToUser")
  admires_admires_admirer_idToUser                                 admires[]                        @relation("admires_admirer_idToUser")
  bio_links                                                        bio_links[]
  brand_campaigns                                                  brand_campaigns[]
  cart_items                                                       cart_items[]
  comment_likes                                                    comment_likes[]
  comment_reports                                                  comment_reports[]
  comments_comments_reply_to_user_idToUser                         comments[]                       @relation("comments_reply_to_user_idToUser")
  comments_comments_user_idToUser                                  comments[]                       @relation("comments_user_idToUser")
  content_unlocks_content_unlocks_creator_idToUser                 content_unlocks[]                @relation("content_unlocks_creator_idToUser")
  content_unlocks_content_unlocks_user_idToUser                    content_unlocks[]                @relation("content_unlocks_user_idToUser")
  contest_engagement_actions                                       contest_engagement_actions[]
  contest_judges                                                   contest_judges[]
  contest_participants                                             contest_participants[]
  contest_purchase_entries                                         contest_purchase_entries[]
  contest_sponsorships                                             contest_sponsorships[]
  contest_votes                                                    contest_votes[]
  contest_winners                                                  contest_winners[]
  conversion_campaign_recipients                                   conversion_campaign_recipients[]
  conversion_campaigns                                             conversion_campaigns[]
  daily_stats                                                      daily_stats[]
  deal_alerts                                                      deal_alerts[]
  escrows                                                          escrows[]
  gamification_activities                                          gamification_activities[]
  gamification_points                                              gamification_points?
  garage_bookings                                                  garage_bookings[]
  garage_profiles                                                  garage_profiles?
  garage_reviews                                                   garage_reviews[]
  gifts_gifts_recipient_idToUser                                   gifts[]                          @relation("gifts_recipient_idToUser")
  gifts_gifts_sender_idToUser                                      gifts[]                          @relation("gifts_sender_idToUser")
  group_buy_participants                                           group_buy_participants[]
  import_requests                                                  import_requests[]
  importer_profiles                                                importer_profiles?
  influencer_profiles                                              influencer_profiles?
  judge_invites                                                    judge_invites[]
  logistics_companies                                              logistics_companies?
  messages_messages_forwarded_from_idToUser                        messages[]                       @relation("messages_forwarded_from_idToUser")
  messages_messages_sender_idToUser                                messages[]                       @relation("messages_sender_idToUser")
  milestone_completions                                            milestone_completions[]
  orders                                                           orders[]
  post_comments                                                    post_comments[]
  post_likes                                                       post_likes[]
  product_reviews                                                  product_reviews[]
  product_shares                                                   product_shares[]
  products                                                         products[]
  refresh_tokens                                                   refresh_tokens[]
  sales_funnel_events                                              sales_funnel_events[]
  shipping_jobs                                                    shipping_jobs[]
  short_comments                                                   short_comments[]
  short_likes                                                      short_likes[]
  shorts                                                           shorts[]
  sponsored_content                                                sponsored_content[]
  sponsored_impressions                                            sponsored_impressions[]
  sponsored_post_requests_sponsored_post_requests_brand_idToUser   sponsored_post_requests[]        @relation("sponsored_post_requests_brand_idToUser")
  sponsored_post_requests_sponsored_post_requests_creator_idToUser sponsored_post_requests[]        @relation("sponsored_post_requests_creator_idToUser")
  subscriptions_subscriptions_creator_idToUser                     subscriptions[]                  @relation("subscriptions_creator_idToUser")
  subscriptions_subscriptions_subscriber_idToUser                  subscriptions[]                  @relation("subscriptions_subscriber_idToUser")
  team_invitations_team_invitations_invitee_idToUser               team_invitations[]               @relation("team_invitations_invitee_idToUser")
  team_invitations_team_invitations_inviter_idToUser               team_invitations[]               @relation("team_invitations_inviter_idToUser")
  team_members                                                     team_members[]
  team_submission_votes                                            team_submission_votes[]
  transactions                                                     transactions[]
  wallets                                                          wallets?
  wishlists                                                        wishlists[]
  notifications                                                    notifications[]
  user_micro_interests                                             user_micro_interests[]
  stories                                                          stories[]
  story_creator                                                    Story[]                          @relation("story_creator")
  story_viewer_preferences                                         StoryViewerPreference[]          @relation("story_viewer_preferences")
  chama_members                                                    ChamaMember[]
  chama_contributions                                              ChamaContribution[]
  chama_payouts                                                    ChamaPayout[]
  chama_payout_approvals                                           ChamaPayoutApproval[]
  chama_transactions                                               ChamaTransaction[]
  chama_nominations_as_nominee                                     ChamaNomination[]                @relation("chama_nomination_nominee")
  chama_nominations_as_nominator                                   ChamaNomination[]                @relation("chama_nomination_nominator")
  chama_secondments                                                ChamaSecondment[]
  chama_votes                                                      ChamaVote[]
  chama_defaulters                                                 ChamaDefaulter[]
  chamas_created                                                   Chama[]                          @relation("chama_creator")
  chat_participants                                                chatParticipant[]
  adminProfile                                                     AdminProfile?
  contentMentions                                                  contentMention[]
  vehicle_favorites                                                vehicle_favorites[]
  suspensions                                                      user_suspensions[]
  withdrawal_requests                                              withdrawal_requests[]

  @@index([fcmToken])
  @@map("user")
}

model chat {
  id           String            @id @default(uuid())
  type         ChatType
  name         String?
  description  String?
  avatar_url   String?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  participants chatParticipant[]
  messages     messages[]
  calls        call[]

  @@map("chat")
}

model chatParticipant {
  id         String   @id @default(uuid())
  chat_id    String
  user_id    String
  role       String   @default("member")
  lastRead   DateTime @default(now())
  created_at DateTime @default(now())
  chat       chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chat_id, user_id], name: "chatId_userId")
  @@index([chat_id])
  @@index([user_id])
  @@map("chat_participant")
}

model Chama {
  id                      String                @id @default(uuid())
  name                    String
  type                    ChamaType
  description             String?
  reason                  String?
  chat_id                 String
  creator_id              String
  status                  ChamaStatus           @default(SETUP)
  isLocked                Boolean               @default(false)
  maxMembers              Int?
  autoLockOnFull          Boolean               @default(false)
  contribution_amount_kr  Decimal               @db.Decimal(18, 4)
  contributionFrequency   ContributionFrequency
  membershipFeeKr         Decimal?              @db.Decimal(18, 4)
  lockPeriodDays          Int?
  penalty_amount_kr       Decimal?              @db.Decimal(18, 4)
  gracePeriodDays         Int                   @default(3)
  current_cycle_number    Int                   @default(1)
  min_approvals           Int                   @default(2)
  allowMidTermVoteOut     Boolean               @default(true)
  avatar_url              String?
  created_at              DateTime              @default(now())
  updated_at              DateTime
  creator                 User                  @relation("chama_creator", fields: [creator_id], references: [id])
  chama_wallet            ChamaWallet?
  chama_members           ChamaMember[]
  chama_cycles            ChamaCycle[]
  chama_transactions      ChamaTransaction[]
  chama_payouts           ChamaPayout[]
  chama_contributions     ChamaContribution[]
  chama_elections         ChamaElection[]
  chama_defaulters        ChamaDefaulter[]

  @@index([status])
  @@index([creator_id])
  @@map("chama")
}

model ChamaMember {
  id                  String              @id @default(uuid())
  chama_id            String
  user_id             String
  role                Chama_Member_Role
  status              Chama_Member_Status @default(ACTIVE)
  is_defaulter        Boolean             @default(false)
  rotationNumber      Int?
  leftAt              DateTime?
  total_contributed   Decimal             @default(0) @db.Decimal(18, 4)
  total_received      Decimal             @default(0) @db.Decimal(18, 4)
  created_at          DateTime            @default(now())
  updated_at          DateTime
  chama               Chama               @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chama_contributions ChamaContribution[]
  chama_payouts       ChamaPayout[]

  @@unique([chama_id, user_id])
  @@index([chama_id])
  @@index([user_id])
  @@map("chama_member")
}

model ChamaWallet {
  id         String   @id @default(uuid())
  chama_id   String   @unique
  kr_balance Decimal  @default(0) @db.Decimal(18, 4)
  created_at DateTime @default(now())
  updated_at DateTime
  chama      Chama    @relation(fields: [chama_id], references: [id], onDelete: Cascade)

  @@index([chama_id])
  @@map("chama_wallet")
}

model ChamaContribution {
  id           String      @id @default(uuid())
  chama_id     String
  member_id    String
  user_id      String
  cycle_number Int
  amount_kr    Decimal     @db.Decimal(18, 4)
  created_at   DateTime    @default(now())
  chama        Chama       @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  member       ChamaMember @relation(fields: [member_id], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([chama_id])
  @@index([member_id])
  @@index([chama_id, cycle_number])
  @@map("chama_contribution")
}

model ChamaCycle {
  id                  String             @id @default(uuid())
  chama_id            String
  cycle_number        Int
  status              Chama_Cycle_Status @default(OPEN)
  collected_amount_kr Decimal            @default(0) @db.Decimal(18, 4)
  target_amount_kr    Decimal            @db.Decimal(18, 4)
  start_date          DateTime
  end_date            DateTime?
  created_at          DateTime           @default(now())
  updated_at          DateTime
  chama               Chama              @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  chama_payouts       ChamaPayout[]

  @@unique([chama_id, cycle_number])
  @@index([chama_id])
  @@index([chama_id, status])
  @@map("chama_cycle")
}

model ChamaPayout {
  id           String                @id @default(uuid())
  chama_id     String
  recipient_id String
  member_id    String
  cycle_id     String?
  amount_kr    Decimal               @db.Decimal(18, 4)
  status       Chama_Payout_Status   @default(PENDING_APPROVAL)
  disbursed_at DateTime?
  created_at   DateTime              @default(now())
  chama        Chama                 @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  recipient    User                  @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  member       ChamaMember           @relation(fields: [member_id], references: [id], onDelete: Cascade)
  cycle        ChamaCycle?           @relation(fields: [cycle_id], references: [id], onDelete: SetNull)
  approvals    ChamaPayoutApproval[]

  @@index([chama_id])
  @@index([recipient_id])
  @@index([chama_id, status])
  @@map("chama_payout")
}

model ChamaPayoutApproval {
  id          String                @id @default(uuid())
  payout_id   String
  approver_id String
  decision    Chama_Payout_Decision
  reason      String?
  created_at  DateTime              @default(now())
  payout      ChamaPayout           @relation(fields: [payout_id], references: [id], onDelete: Cascade)
  approver    User                  @relation(fields: [approver_id], references: [id], onDelete: Cascade)

  @@index([payout_id])
  @@index([approver_id])
  @@map("chama_payout_approval")
}

model ChamaTransaction {
  id          String                 @id @default(uuid())
  chama_id    String
  user_id     String
  type        Chama_Transaction_Type
  amount_kr   Decimal                @db.Decimal(18, 4)
  description String
  receipt_url String?
  created_at  DateTime               @default(now())
  chama       Chama                  @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([chama_id])
  @@index([chama_id, created_at])
  @@map("chama_transaction")
}

model ChamaElection {
  id           String               @id @default(uuid())
  chama_id     String
  position     Chama_Member_Role
  phase        Chama_Election_Phase @default(NOMINATION)
  is_mid_term  Boolean              @default(false)
  completed_at DateTime?
  created_at   DateTime             @default(now())
  updated_at   DateTime
  chama        Chama                @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  nominations  ChamaNomination[]
  votes        ChamaVote[]

  @@index([chama_id])
  @@index([chama_id, phase])
  @@map("chama_election")
}

model ChamaNomination {
  id            String            @id @default(uuid())
  election_id   String
  nominee_id    String
  nominator_id  String
  seconds_count Int               @default(0)
  created_at    DateTime          @default(now())
  election      ChamaElection     @relation(fields: [election_id], references: [id], onDelete: Cascade)
  nominee       User              @relation("chama_nomination_nominee", fields: [nominee_id], references: [id], onDelete: Cascade)
  nominator     User              @relation("chama_nomination_nominator", fields: [nominator_id], references: [id], onDelete: Cascade)
  secondments   ChamaSecondment[]
  votes         ChamaVote[]

  @@unique([election_id, nominee_id])
  @@index([election_id])
  @@index([nominee_id])
  @@map("chama_nomination")
}

model ChamaSecondment {
  id            String          @id @default(uuid())
  nomination_id String
  seconder_id   String
  created_at    DateTime        @default(now())
  nomination    ChamaNomination @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  seconder      User            @relation(fields: [seconder_id], references: [id], onDelete: Cascade)

  @@unique([nomination_id, seconder_id])
  @@index([nomination_id])
  @@index([seconder_id])
  @@map("chama_secondment")
}

model ChamaVote {
  id            String          @id @default(uuid())
  election_id   String
  nomination_id String
  voter_id      String
  created_at    DateTime        @default(now())
  election      ChamaElection   @relation(fields: [election_id], references: [id], onDelete: Cascade)
  nomination    ChamaNomination @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  voter         User            @relation(fields: [voter_id], references: [id], onDelete: Cascade)

  @@unique([election_id, voter_id])
  @@index([election_id])
  @@index([nomination_id])
  @@index([voter_id])
  @@map("chama_vote")
}

model ChamaDefaulter {
  id             String    @id @default(uuid())
  user_id        String
  chama_id       String
  chama_name     String
  amount_owed_kr Decimal   @db.Decimal(18, 4)
  fine_amount_kr Decimal   @default(0) @db.Decimal(18, 4)
  is_resolved    Boolean   @default(false)
  created_at     DateTime  @default(now())
  resolved_at    DateTime?
  chama          Chama     @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([chama_id])
  @@index([user_id, is_resolved])
  @@map("chama_defaulter")
}

model ad_analytics {
  id                          String   @id @default(uuid())
  date                        DateTime @unique @db.Date
  total_ad_spend_kes          Decimal  @default(0) @db.Decimal(18, 4)
  platform_revenue_kes        Decimal  @default(0) @db.Decimal(18, 4)
  creator_revenue_kes         Decimal  @default(0) @db.Decimal(18, 4)
  active_campaigns            Int      @default(0)
  total_impressions           Int      @default(0)
  total_clicks                Int      @default(0)
  total_conversions           Int      @default(0)
  native_impressions          Int      @default(0)
  banner_impressions          Int      @default(0)
  story_impressions           Int      @default(0)
  sponsored_posts_active      Int      @default(0)
  sponsored_posts_revenue_kes Decimal  @default(0) @db.Decimal(18, 4)
  created_at                  DateTime @default(now())

  @@index([date])
  @@map("ad_analytics")
}

model ad_campaign_locations {
  id                   String               @id @default(uuid())
  campaign_id          String
  scope                TargetingScope
  scope_value          String
  scope_display_name   String
  continent            String?
  country              String?
  region               String?
  city                 String?
  town                 String?
  road                 String?
  landmark             String?
  shopping_center      String?
  latitude             Decimal?             @db.Decimal(10, 7)
  longitude            Decimal?             @db.Decimal(10, 7)
  radius_km            Decimal?             @db.Decimal(6, 2)
  is_excluded          Boolean              @default(false)
  created_at           DateTime             @default(now())
  display_ad_campaigns display_ad_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id])
  @@index([scope, scope_value])
  @@map("ad_campaign_locations")
}

model ad_campaigns {

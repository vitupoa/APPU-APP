generator client {
  provider = "prisma-client-js"
  fieldMapping = "camelCase"
}

datasource db {
  provider = "postgresql"
}

model Contest {
  id                          String                        @id
  creator_id                  String
  title                       String
  description                 String?
  media_type                  ContestMediaType
  category                    String
  cover_media_url             String?
  prize_total_kr              Decimal                       @db.Decimal(18, 4)
  platform_fee_kr             Decimal                       @db.Decimal(18, 4)
  participation_type          ParticipationType             @default(INDIVIDUAL_ONLY)
  team_size                   Int?
  max_teams                   Int?
  entry_fee_kr                Decimal?                      @db.Decimal(18, 4)
  public_vote_weight          Int?
  target_ages                 Int[]
  target_geos                 String[]
  airdrop_kr                  Decimal?                      @db.Decimal(18, 4)
  airdrop_limit               Int?
  allow_daily_prizes          Boolean                       @default(false)
  daily_prize_kr              Decimal?                      @db.Decimal(18, 4)
  max_winners                 Int                           @db.SmallInt
  judging_criteria            JudgingCriteria
  sponsor_name                String?
  sponsor_url                 String?
  deadline                    DateTime
  status                      ContestStatus                 @default(ACTIVE)
  total_participants          Int                           @default(0)
  total_submissions           Int                           @default(0)
  created_at                  DateTime                      @default(now())
  User                        User                          @relation(fields: [creator_id], references: [id])
  ContestAction               ContestAction[]
  ContestSubmission           ContestSubmission[]
  brand_campaigns             brand_campaigns[]
  contest_analytics           contest_analytics[]
  contest_engagement_actions  contest_engagement_actions[]
  contest_judges              contest_judges[]
  contest_participants        contest_participants[]
  contest_prize_distributions contest_prize_distributions[]
  contest_purchase_entries    contest_purchase_entries[]
  contest_sponsorships        contest_sponsorships[]
  contest_winners             contest_winners[]
  conversion_campaigns        conversion_campaigns[]
  escrows                     escrows[]
  judge_invites               judge_invites[]
  milestones                  milestones[]
  sales_funnel_events         sales_funnel_events[]
  shorts                      shorts[]
  team_contest_registrations  team_contest_registrations[]
  team_submissions            team_submissions[]

  @@index([status, deadline])
}

model ContestAction {
  id                         String                       @id
  contest_id                 String
  action_type                RequirementType
  target_url                 String?
  label                      String
  is_verifiable              Boolean                      @default(false)
  requires_upload            Boolean                      @default(false)
  sort_order                 Int                          @default(0)
  Contest                    Contest                      @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  contest_action_completions contest_action_completions[]
}

model ContestSubmission {
  id                         String                       @id
  contest_id                 String
  user_id                    String
  media_url                  String
  media_type                 String
  proof_urls                 String[]
  votes_count                Int                          @default(0)
  judge_score                Decimal?                     @default(0) @db.Decimal(5, 2)
  final_score                Decimal?                     @db.Decimal(7, 2)
  rank                       Int?
  submitted_at               DateTime                     @default(now())
  Contest                    Contest                      @relation(fields: [contest_id], references: [id], onDelete: Cascade)
  User                       User                         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contest_action_completions contest_action_completions[]
  contest_votes              contest_votes[]

  @@unique([contest_id, user_id])
}

model LiveSession {
  id                    String                  @id
  host_id               String
  title                 String
  description           String?
  scheduled_start       DateTime
  actual_start          DateTime?
  ended_at              DateTime?
  status                String                  @default("SCHEDULED")
  viewer_count          Int                     @default(0)
  peak_viewers          Int                     @default(0)
  total_sales_kr        Decimal                 @default(0) @db.Decimal(18, 4)
  created_at            DateTime                @default(now())
  User                  User                    @relation(fields: [host_id], references: [id], onDelete: Cascade)
  live_session_products live_session_products[]

  @@index([host_id, status])
  @@index([status, scheduled_start])
}

model LiveStream {
  id                                                       String                 @id
  host_id                                                  String
  title                                                    String
  description                                              String?
  category                                                 String?                @default("Chat") @db.VarChar(50)
  thumbnail_url                                            String?
  type                                                     LiveStreamType         @default(NORMAL)
  status                                                   LiveStreamStatus       @default(SCHEDULED)
  stream_key                                               String                 @unique
  stream_url                                               String?
  playback_url                                             String?
  viewer_count                                             Int                    @default(0)
  peak_viewers                                             Int                    @default(0)
  likes_count                                              Int                    @default(0)
  total_tips_kr                                            Decimal                @default(0) @db.Decimal(18, 4)
  total_sales_kr                                           Decimal                @default(0) @db.Decimal(18, 4)
  gift_goal_title                                          String?
  gift_goal_target                                         Decimal?               @db.Decimal(18, 4)
  gift_goal_current                                        Decimal                @default(0) @db.Decimal(18, 4)
  unlock_amount_kr                                         Decimal?               @db.Decimal(18, 4)
  chama_id                                                 String?
  contest_id                                               String?
  order_id                                                 String?
  is_co_host_enabled                                       Boolean                @default(false)
  max_co_hosts                                             Int                    @default(1)
  scheduled_start                                          DateTime?
  actual_start                                             DateTime?
  ended_at                                                 DateTime?
  created_at                                               DateTime               @default(now())
  User                                                     User                   @relation(fields: [host_id], references: [id], onDelete: Cascade)
  live_banned_viewers                                      live_banned_viewers[]
  live_battles_live_battles_opponent_stream_idToLiveStream live_battles[]         @relation("live_battles_opponent_stream_idToLiveStream")
  live_battles_live_battles_stream_idToLiveStream          live_battles[]         @relation("live_battles_stream_idToLiveStream")
  live_co_hosts                                            live_co_hosts[]
  live_messages                                            live_messages[]
  live_pinned_products                                     live_pinned_products[]
  live_tips                                                live_tips[]
  live_viewers                                             live_viewers[]

  @@index([category, status])
  @@index([host_id, status])
  @@index([status, created_at])
  @@index([status, viewer_count], map: "live_streams_status_viewers_idx")
}

model Post {
  id               String                @id
  user_id          String
  caption          String?
  image_urls       String[]
  is_locked        Boolean               @default(false)
  required_tier    SubscriptionTierType?
  likes_count      Int                   @default(0)
  comments_count   Int                   @default(0)
  created_at       DateTime              @default(now())
  unlock_amount_kr Decimal?              @db.Decimal(18, 4)
  User             User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_comments    post_comments[]
  post_likes       post_likes[]

  @@index([user_id, created_at])
}

model ShortCollection {
  id         String   @id
  user_id    String
  name       String
  cover_url  String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shorts     shorts[]
}

model SubscriptionTier {
  id            String               @id
  creator_id    String
  tier          SubscriptionTierType
  kr_amount     Decimal              @db.Decimal(18, 4)
  benefits      String
  is_enabled    Boolean              @default(true)
  created_at    DateTime             @default(now())
  User          User                 @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  subscriptions subscriptions[]

  @@unique([creator_id, tier])
}

model Team {
  id                         String                       @id
  name                       String                       @unique @db.VarChar(50)
  avatar_url                 String?
  leader_id                  String
  max_members                Int                          @default(5)
  total_wins                 Int                          @default(0)
  total_prizes               Decimal                      @default(0) @db.Decimal(18, 4)
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  User                       User                         @relation(fields: [leader_id], references: [id], onDelete: Cascade)
  team_chats                 team_chats?
  team_contest_registrations team_contest_registrations[]
  team_invitations           team_invitations[]
  team_members               team_members[]
  team_submissions           team_submissions[]
}

model User {
  id                                                               String                           @id
  email                                                            String                           @unique
  username                                                         String                           @unique
  first_name                                                       String
  last_name                                                        String
  display_name                                                     String
  avatar_url                                                       String?
  cover_photo_url                                                  String?
  bio                                                              String?
  country                                                          String                           @db.VarChar(2)
  currency                                                         String                           @db.VarChar(3)
  google_id                                                        String?                          @unique
  apple_id                                                         String?                          @unique
  account_type                                                     AccountType                      @default(CREATOR)
  is_admin                                                         Boolean                          @default(false)
  is_verified                                                      Boolean                          @default(false)
  is_wallet_unlocked                                               Boolean                          @default(false)
  wallet_pin_hash                                                  String?
  password_hash                                                    String?
  created_at                                                       DateTime                         @default(now())
  updated_at                                                       DateTime
  devicePlatform                                                   String?
  fcmToken                                                         String?
  Contest                                                          Contest[]
  ContestSubmission                                                ContestSubmission[]
  LiveSession                                                      LiveSession[]
  LiveStream                                                       LiveStream[]
  Post                                                             Post[]
  ShortCollection                                                  ShortCollection[]
  SubscriptionTier                                                 SubscriptionTier[]
  Team                                                             Team[]
  ad_campaigns                                                     ad_campaigns[]
  admires_admires_admired_idToUser                                 admires[]                        @relation("admires_admired_idToUser")
  admires_admires_admirer_idToUser                                 admires[]                        @relation("admires_admirer_idToUser")
  bio_links                                                        bio_links[]
  brand_campaigns                                                  brand_campaigns[]
  cart_items                                                       cart_items[]
  comment_likes                                                    comment_likes[]
  comment_reports                                                  comment_reports[]
  comments_comments_reply_to_user_idToUser                         comments[]                       @relation("comments_reply_to_user_idToUser")
  comments_comments_user_idToUser                                  comments[]                       @relation("comments_user_idToUser")
  content_unlocks_content_unlocks_creator_idToUser                 content_unlocks[]                @relation("content_unlocks_creator_idToUser")
  content_unlocks_content_unlocks_user_idToUser                    content_unlocks[]                @relation("content_unlocks_user_idToUser")
  contest_engagement_actions                                       contest_engagement_actions[]
  contest_judges                                                   contest_judges[]
  contest_participants                                             contest_participants[]
  contest_purchase_entries                                         contest_purchase_entries[]
  contest_sponsorships                                             contest_sponsorships[]
  contest_votes                                                    contest_votes[]
  contest_winners                                                  contest_winners[]
  conversion_campaign_recipients                                   conversion_campaign_recipients[]
  conversion_campaigns                                             conversion_campaigns[]
  daily_stats                                                      daily_stats[]
  deal_alerts                                                      deal_alerts[]
  escrows                                                          escrows[]
  gamification_activities                                          gamification_activities[]
  gamification_points                                              gamification_points?
  garage_bookings                                                  garage_bookings[]
  garage_profiles                                                  garage_profiles?
  garage_reviews                                                   garage_reviews[]
  gifts_gifts_recipient_idToUser                                   gifts[]                          @relation("gifts_recipient_idToUser")
  gifts_gifts_sender_idToUser                                      gifts[]                          @relation("gifts_sender_idToUser")
  group_buy_participants                                           group_buy_participants[]
  import_requests                                                  import_requests[]
  importer_profiles                                                importer_profiles?
  influencer_profiles                                              influencer_profiles?
  judge_invites                                                    judge_invites[]
  logistics_companies                                              logistics_companies?
  messages_messages_forwarded_from_idToUser                        messages[]                       @relation("messages_forwarded_from_idToUser")
  messages_messages_sender_idToUser                                messages[]                       @relation("messages_sender_idToUser")
  milestone_completions                                            milestone_completions[]
  orders                                                           orders[]
  post_comments                                                    post_comments[]
  post_likes                                                       post_likes[]
  product_reviews                                                  product_reviews[]
  product_shares                                                   product_shares[]
  products                                                         products[]
  refresh_tokens                                                   refresh_tokens[]
  sales_funnel_events                                              sales_funnel_events[]
  shipping_jobs                                                    shipping_jobs[]
  short_comments                                                   short_comments[]
  short_likes                                                      short_likes[]
  shorts                                                           shorts[]
  sponsored_content                                                sponsored_content[]
  sponsored_impressions                                            sponsored_impressions[]
  sponsored_post_requests_sponsored_post_requests_brand_idToUser   sponsored_post_requests[]        @relation("sponsored_post_requests_brand_idToUser")
  sponsored_post_requests_sponsored_post_requests_creator_idToUser sponsored_post_requests[]        @relation("sponsored_post_requests_creator_idToUser")
  subscriptions_subscriptions_creator_idToUser                     subscriptions[]                  @relation("subscriptions_creator_idToUser")
  subscriptions_subscriptions_subscriber_idToUser                  subscriptions[]                  @relation("subscriptions_subscriber_idToUser")
  team_invitations_team_invitations_invitee_idToUser               team_invitations[]               @relation("team_invitations_invitee_idToUser")
  team_invitations_team_invitations_inviter_idToUser               team_invitations[]               @relation("team_invitations_inviter_idToUser")
  team_members                                                     team_members[]
  team_submission_votes                                            team_submission_votes[]
  transactions                                                     transactions[]
  wallets                                                          wallets?
  wishlists                                                        wishlists[]
  notifications                                                    notifications[]
  user_micro_interests                                             user_micro_interests[]
  stories                                                          stories[]

  @@index([fcmToken])
}

model ad_analytics {
  id                          String   @id
  date                        DateTime @unique @db.Date
  total_ad_spend_kes          Decimal  @default(0) @db.Decimal(18, 4)
  platform_revenue_kes        Decimal  @default(0) @db.Decimal(18, 4)
  creator_revenue_kes         Decimal  @default(0) @db.Decimal(18, 4)
  active_campaigns            Int      @default(0)
  total_impressions           Int      @default(0)
  total_clicks                Int      @default(0)
  total_conversions           Int      @default(0)
  native_impressions          Int      @default(0)
  banner_impressions          Int      @default(0)
  story_impressions           Int      @default(0)
  sponsored_posts_active      Int      @default(0)
  sponsored_posts_revenue_kes Decimal  @default(0) @db.Decimal(18, 4)
  created_at                  DateTime @default(now())

  @@index([date])
}

model ad_campaign_locations {
  id                   String               @id
  campaign_id          String
  scope                TargetingScope
  scope_value          String
  scope_display_name   String
  continent            String?
  country              String?
  region               String?
  city                 String?
  town                 String?
  road                 String?
  landmark             String?
  shopping_center      String?
  latitude             Decimal?             @db.Decimal(10, 7)
  longitude            Decimal?             @db.Decimal(10, 7)
  radius_km            Decimal?             @db.Decimal(6, 2)
  is_excluded          Boolean              @default(false)
  created_at           DateTime             @default(now())
  display_ad_campaigns display_ad_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id])
  @@index([scope, scope_value])
}

model ad_campaigns {
  id               String               @id
  brand_id         String
  campaign_name    String
  ad_type          AdType
  budget_kes       Decimal              @db.Decimal(18, 4)
  spent_kes        Decimal              @default(0) @db.Decimal(18, 4)
  cpm_bid          Decimal              @db.Decimal(10, 2)
  target_age_min   Int?
  target_age_max   Int?
  target_genders   String[]
  target_locations String[]
  target_interests String[]
  title            String
  description      String?
  image_url        String?
  cta_text         String?              @db.VarChar(50)
  cta_url          String?
  start_date       DateTime
  end_date         DateTime
  status           AdCampaignStatusType @default(PENDING)
  rejection_reason String?
  impressions      Int                  @default(0)
  clicks           Int                  @default(0)
  conversions      Int                  @default(0)
  approved_by      String?
  approved_at      DateTime?
  created_at       DateTime             @default(now())
  updated_at       DateTime
  User             User                 @relation(fields: [brand_id], references: [id], onDelete: Cascade)

  @@index([brand_id])
  @@index([start_date, end_date])
  @@index([status])
}

model ad_config {
  id                      String   @id
  platform_cut_percentage Decimal  @default(15.0) @db.Decimal(5, 2)
  native_ad_min_cpm       Decimal  @default(40.0) @db.Decimal(10, 2)
  native_ad_max_cpm       Decimal  @default(150.0) @db.Decimal(10, 2)
  native_ad_frequency     Int      @default(6)
  banner_ad_min_cpm       Decimal  @default(30.0) @db.Decimal(10, 2)
  banner_ad_max_cpm       Decimal  @default(100.0) @db.Decimal(10, 2)
  banner_ad_frequency     Int      @default(15)
  story_ad_min_cpm        Decimal  @default(80.0) @db.Decimal(10, 2)
  story_ad_max_cpm        Decimal  @default(200.0) @db.Decimal(10, 2)
  story_ad_frequency      Int      @default(20)
  ads_enabled             Boolean  @default(true)
  max_ad_load_enabled     Boolean  @default(false)
  updated_by              String?
  created_at              DateTime @default(now())
  updated_at              DateTime
}

model ad_impressions {
  id               String        @id
  campaign_id      String
  user_id          String
  placement        PlacementType
  content_id       String?
  content_type     String?
  chat_id          String?
  chat_niche       ChatNiche?
  was_clicked      Boolean       @default(false)
  was_converted    Boolean       @default(false)
  view_duration_ms Int           @default(0)
  cost_kes         Decimal       @db.Decimal(10, 4)
  user_country     String?
  user_city        String?
  created_at       DateTime      @default(now())

  @@index([campaign_id, user_id])
  @@index([placement, created_at])
  @@index([user_id, created_at])
}

model ad_platform_settings {
  id                      String         @id
  scope                   TargetingScope
  scope_value             String?
  min_daily_budget_kes    Decimal        @db.Decimal(18, 4)
  min_lifetime_budget_kes Decimal        @db.Decimal(18, 4)
  live_stream_min_cpm     Decimal        @db.Decimal(10, 2)
  live_stream_max_cpm     Decimal        @db.Decimal(10, 2)
  contest_min_cpm         Decimal        @db.Decimal(10, 2)
  contest_max_cpm         Decimal        @db.Decimal(10, 2)
  discover_min_cpm        Decimal        @db.Decimal(10, 2)
  discover_max_cpm        Decimal        @db.Decimal(10, 2)
  admiring_min_cpm        Decimal        @db.Decimal(10, 2)
  admiring_max_cpm        Decimal        @db.Decimal(10, 2)
  drips_min_cpm           Decimal        @db.Decimal(10, 2)
  drips_max_cpm           Decimal        @db.Decimal(10, 2)
  stories_min_cpm         Decimal        @db.Decimal(10, 2)
  stories_max_cpm         Decimal        @db.Decimal(10, 2)
  group_chat_min_cpm      Decimal        @db.Decimal(10, 2)
  group_chat_max_cpm      Decimal        @db.Decimal(10, 2)
  chama_chat_min_cpm      Decimal        @db.Decimal(10, 2)
  chama_chat_max_cpm      Decimal        @db.Decimal(10, 2)
  targeting_multiplier    Decimal        @default(1.0) @db.Decimal(3, 2)
  priority                Int            @default(0)
  is_active               Boolean        @default(true)
  created_by              String?
  updated_by              String?
  created_at              DateTime       @default(now())
  updated_at              DateTime

  @@unique([scope, scope_value])
  @@index([scope, priority])
}

model admires {
  id                            String   @id
  admirer_id                    String
  admired_id                    String
  is_lovers                     Boolean  @default(false)
  created_at                    DateTime @default(now())
  User_admires_admired_idToUser User     @relation("admires_admired_idToUser", fields: [admired_id], references: [id], onDelete: Cascade)
  User_admires_admirer_idToUser User     @relation("admires_admirer_idToUser", fields: [admirer_id], references: [id], onDelete: Cascade)

  @@unique([admirer_id, admired_id])
}

model bio_links {
  id         String  @id
  user_id    String
  label      String
  url        String
  icon       String?
  sort_order Int     @default(0)
  User       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model book_details {
  id           String   @id
  product_id   String   @unique
  author       String
  isbn         String?
  publisher    String?
  edition      String?
  language     String?
  page_count   Int?
  genre        String?
  downloadable Boolean  @default(false)
  download_url String?
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model brand_campaigns {
  id                          String                  @id
  brand_id                    String
  title                       String
  description                 String
  type                        CampaignType
  status                      CampaignStatus          @default(DRAFT)
  target_tiers                InfluencerTier[]
  target_categories           String[]
  min_followers               Int?
  min_engagement_rate         Decimal?                @db.Decimal(5, 2)
  target_geos                 String[]
  budget_kr                   Decimal                 @db.Decimal(18, 4)
  compensation_per_influencer Decimal                 @db.Decimal(18, 4)
  max_influencers             Int
  required_posts              Int                     @default(0)
  required_videos             Int                     @default(0)
  required_stories            Int                     @default(0)
  content_guidelines          String?
  hashtags                    String[]
  mentions                    String[]
  contest_id                  String?
  application_deadline        DateTime?
  campaign_start_date         DateTime
  campaign_end_date           DateTime
  total_applications          Int                     @default(0)
  accepted_influencers        Int                     @default(0)
  total_reach                 Int                     @default(0)
  total_engagement            Int                     @default(0)
  total_conversions           Int                     @default(0)
  total_revenue_kr            Decimal                 @default(0) @db.Decimal(18, 4)
  roi                         Decimal                 @default(0) @db.Decimal(10, 2)
  created_at                  DateTime                @default(now())
  updated_at                  DateTime
  User                        User                    @relation(fields: [brand_id], references: [id])
  Contest                     Contest?                @relation(fields: [contest_id], references: [id])
  campaign_analytics          campaign_analytics[]
  campaign_applications       campaign_applications[]
  campaign_deliverables       campaign_deliverables[]
  sales_funnel_events         sales_funnel_events[]

  @@index([brand_id])
  @@index([contest_id])
  @@index([status, campaign_start_date])
}

model campaign_analytics {
  id              String          @id
  campaign_id     String
  date            DateTime        @db.Date
  impressions     Int             @default(0)
  reach           Int             @default(0)
  engagement      Int             @default(0)
  clicks          Int             @default(0)
  conversions     Int             @default(0)
  revenue         Decimal         @default(0) @db.Decimal(18, 4)
  spent_kr        Decimal         @default(0) @db.Decimal(18, 4)
  ctr             Decimal         @default(0) @db.Decimal(5, 4)
  conversion_rate Decimal         @default(0) @db.Decimal(5, 4)
  cpa             Decimal         @default(0) @db.Decimal(18, 4)
  roas            Decimal         @default(0) @db.Decimal(10, 2)
  brand_campaigns brand_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, date])
  @@index([date])
}

model campaign_applications {
  id                  String              @id
  campaign_id         String
  influencer_id       String
  status              ApplicationStatus   @default(PENDING)
  pitch               String
  proposed_rate       Decimal?            @db.Decimal(18, 4)
  availability        String?
  response_note       String?
  responded_at        DateTime?
  applied_at          DateTime            @default(now())
  brand_campaigns     brand_campaigns     @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  influencer_profiles influencer_profiles @relation(fields: [influencer_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, influencer_id])
  @@index([influencer_id, status])
}

model campaign_deliverables {
  id                  String              @id
  campaign_id         String
  influencer_id       String
  type                String
  platform            String
  content_url         String
  caption             String?
  views               Int                 @default(0)
  likes               Int                 @default(0)
  comments            Int                 @default(0)
  shares              Int                 @default(0)

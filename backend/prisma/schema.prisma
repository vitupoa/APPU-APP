// ─── COMMENTS ─────────────────────────────────────────────

model Comment {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  contentId     String    @map("content_id")
  contentType   String    @map("content_type")
  text          String
  parentId      String?   @map("parent_id")
  replyToUserId String?   @map("reply_to_user_id")
  likesCount    Int       @default(0) @map("likes_count")
  repliesCount  Int       @default(0) @map("replies_count")
  isPinned      Boolean   @default(false) @map("is_pinned")
  isEdited      Boolean   @default(false) @map("is_edited")
  createdAt     DateTime  @default(now()) @map("created_at")
  editedAt      DateTime? @map("edited_at")

  author       User           @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  parent       Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]      @relation("CommentReplies")
  replyToUser  User?          @relation("CommentReplyTo", fields: [replyToUserId], references: [id], onDelete: SetNull)
  likes        CommentLike[]
  reports      CommentReport[]

  @@index([contentType, contentId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([isPinned, createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

model CommentReport {
  id         String   @id @default(uuid())
  commentId  String   @map("comment_id")
  reporterId String   @map("reporter_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation("CommentReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_reports")
}

model CommentSettings {
  id              String  @id @default(uuid())
  contentId       String  @map("content_id")
  contentType     String  @map("content_type")
  commentsEnabled Boolean @default(true) @map("comments_enabled")
  repliesEnabled  Boolean @default(true) @map("replies_enabled")

  @@unique([contentId, contentType])
  @@map("comment_settings")
}

// ─── TEAMS ────────────────────────────────────────────────

enum TeamRole {
  LEADER
  CO_LEADER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  avatarUrl   String?  @map("avatar_url")
  leaderId    String   @map("leader_id")
  maxMembers  Int      @default(5) @map("max_members")
  totalWins   Int      @default(0) @map("total_wins")
  totalPrizes Decimal  @default(0) @map("total_prizes") @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leader        User                      @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  invitations   TeamInvitation[]
  registrations TeamContestRegistration[]
  submissions   TeamSubmission[]
  chat          TeamChat?

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("TeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id         String           @id @default(uuid())
  teamId     String           @map("team_id")
  inviterId  String           @map("inviter_id")
  inviteeId  String           @map("invitee_id")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter  User @relation("TeamInvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee  User @relation("TeamInvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([teamId, inviteeId, status])
  @@index([inviteeId, status])
  @@index([teamId, status])
  @@map("team_invitations")
}

model TeamContestRegistration {
  id           String   @id @default(uuid())
  contestId    String   @map("contest_id")
  teamId       String   @map("team_id")
  registeredAt DateTime @default(now()) @map("registered_at")

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([contestId, teamId])
  @@index([contestId])
  @@index([teamId])
  @@map("team_contest_registrations")
}

model TeamSubmission {
  id           String   @id @default(uuid())
  contestId    String   @map("contest_id")
  teamId       String   @map("team_id")
  mediaUrl     String   @map("media_url")
  mediaType    String   @map("media_type")
  caption      String?
  contributors String[] // Array of user IDs
  votesCount   Int      @default(0) @map("votes_count")
  judgeScore   Decimal? @default(0) @map("judge_score") @db.Decimal(5, 2)
  finalScore   Decimal? @map("final_score") @db.Decimal(7, 2)
  rank         Int?
  submittedAt  DateTime @default(now()) @map("submitted_at")

  contest Contest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  team    Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  votes   TeamSubmissionVote[]

  @@unique([contestId, teamId])
  @@index([contestId, votesCount])
  @@map("team_submissions")
}

model TeamSubmissionVote {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  voterId      String   @map("voter_id")
  createdAt    DateTime @default(now()) @map("created_at")

  submission TeamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voter      User           @relation("TeamSubmissionVotes", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([submissionId, voterId])
  @@index([submissionId])
  @@map("team_submission_votes")
}

model TeamChat {
  id        String   @id @default(uuid())
  teamId    String   @unique @map("team_id")
  chatId    String   @map("chat_id")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_chats")
}

// ─── HASHTAGS & MENTIONS ──────────────────────────────────

model Hashtag {
  id          String   @id @default(uuid())
  tag         String   @unique // normalized lowercase, no #
  usageCount  Int      @default(1) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")

  contentTags ContentHashtag[]


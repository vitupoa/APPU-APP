// ─── CAR IMPORTERS & LOGISTICS ──────────────────────────

model ImporterProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  businessName      String   @map("business_name")
  description       String?  @db.Text
  countriesServed   String[] @map("countries_served")
  specialization    String?
  yearsExperience   Int?     @map("years_experience")
  totalImports      Int      @default(0) @map("total_imports")
  isVerified        Boolean  @default(false) @map("is_verified")
  createdAt         DateTime @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes  ImportQuote[]

  @@map("importer_profiles")
}

model ImportRequest {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  make            String
  model           String
  yearFrom        Int?                @map("year_from")
  yearTo          Int?                @map("year_to")
  countryOfOrigin String?             @map("country_of_origin")
  budget          Decimal?            @db.Decimal(18, 4)
  requirements    String?             @db.Text
  status          ImportRequestStatus @default(PENDING)
  createdAt       DateTime            @default(now()) @map("created_at")

  user   User          @relation("ImportRequester", fields: [userId], references: [id])
  quotes ImportQuote[]

  @@index([userId, status])
  @@map("import_requests")
}

model ImportQuote {
  id              String   @id @default(uuid())
  requestId       String   @map("request_id")
  importerId      String   @map("importer_id")
  quoteAmountKr   Decimal  @map("quote_amount_kr") @db.Decimal(18, 4)
  estimatedDays   Int?     @map("estimated_days")
  notes           String?  @db.Text
  status          String   @default("pending") // pending, accepted, rejected
  createdAt       DateTime @default(now()) @map("created_at")

  request  ImportRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  importer ImporterProfile @relation(fields: [importerId], references: [id])


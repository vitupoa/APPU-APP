  contentId   String   @map("content_id")
  contentType String   @map("content_type") // POST, SHORT, CONTEST
  createdAt   DateTime @default(now()) @map("created_at")

  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([hashtagId, contentId, contentType])
  @@index([contentId, contentType])
  @@index([hashtagId])
  @@map("content_hashtags")
}

model ContentMention {
  id              String   @id @default(uuid())
  mentionedUserId String   @map("mentioned_user_id")
  contentId       String   @map("content_id")
  contentType     String   @map("content_type") // POST, SHORT, CONTEST
  createdAt       DateTime @default(now()) @map("created_at")


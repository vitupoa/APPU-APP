// Prisma Schema for Secure Financial Transactions
// This schema includes all tables needed for the security implementation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// EXISTING MODELS (Add these if you don't have them)
// ============================================================================

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  phone             String?  @unique
  username          String   @unique
  firstName         String
  lastName          String
  displayName       String
  avatarUrl         String?
  coverPhotoUrl     String?
  bio               String?
  country           String
  currency          String
  accountType       String
  isVerified        Boolean  @default(false)
  isWalletUnlocked  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  wallet                  Wallet?
  sessionSecrets          UserSessionSecret[]
  transactionsSent        Transaction[]       @relation("SenderTransactions")
  transactionsReceived    Transaction[]       @relation("RecipientTransactions")
  transactionNonces       TransactionNonce[]
  financialTransactionLog FinancialTransactionLog[]

  @@index([email])
  @@index([username])
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String   @unique
  krBalance  Decimal  @default(0) @db.Decimal(20, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  type            TransactionType
  amountKr        Decimal           @db.Decimal(20, 2)
  amountFiat      Decimal?          @db.Decimal(20, 2)
  currency        String?
  provider        String?
  status          TransactionStatus @default(PENDING)
  reference       String?
  counterpartyId  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user         User  @relation("SenderTransactions", fields: [userId], references: [id], onDelete: Cascade)
  counterparty User? @relation("RecipientTransactions", fields: [counterpartyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([counterpartyId])
  @@index([status])
  @@index([createdAt])
}

enum TransactionType {
  TIP
  WITHDRAW
  TOPUP
  PURCHASE
  REFUND
  UNKNOWN
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  UNKNOWN
}

// ============================================================================
// SECURITY MODELS (NEW - Required for secure financial transactions)
// ============================================================================

// Session Secrets Table
// Stores server-generated secrets for HMAC-SHA256 transaction signing
model UserSessionSecret {
  id        BigInt   @id @default(autoincrement())
  userId    String
  secret    Bytes    // 256-bit (32 bytes) cryptographically secure secret
  createdAt DateTime @default(now())
  expiresAt DateTime // Expires after 24-48 hours
  isActive  Boolean  @default(true)
  deviceId  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([expiresAt])
  @@map("user_session_secrets")
}

// Transaction Nonces Table
// Tracks nonces to prevent replay attacks
model TransactionNonce {
  id              BigInt   @id @default(autoincrement())
  nonce           String   @unique
  userId          String
  transactionType String   // TIP, WITHDRAW, TOPUP
  createdAt       DateTime @default(now())
  expiresAt       DateTime // Expires after 10 minutes

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nonce])
  @@index([expiresAt])
  @@index([userId])
  @@map("transaction_nonces")
}

// Financial Transactions Log
// Comprehensive audit trail for all financial transactions
model FinancialTransactionLog {
  id             BigInt   @id @default(autoincrement())
  transactionId  String
  userId         String
  transactionType String  // TIP, WITHDRAW, TOPUP
  amountKr       Decimal  @db.Decimal(20, 2)
  amountFiat     Decimal? @db.Decimal(20, 2)
  currency       String?
  provider       String?
  counterpartyId String?
  signature      String   // HMAC-SHA256 signature
  nonce          String
  timestamp      BigInt   // Client timestamp
  ipAddress      String?
  userAgent      String?
  deviceId       String?
  status         String   // PENDING, COMPLETED, FAILED
  errorMessage   String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
  @@map("financial_transactions_log")
}

// Rate Limiting Table (Optional - can use Redis instead)
model RateLimit {
  id        BigInt   @id @default(autoincrement())
  userId    String
  action    String   // tip, withdraw, topup
  count     Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt DateTime

  @@unique([userId, action, windowStart])
  @@index([userId, action])
  @@index([expiresAt])
  @@map("rate_limits")
}

// Suspicious Activity Log
model SuspiciousActivityLog {
  id          BigInt   @id @default(autoincrement())
  userId      String
  activityType String  // RAPID_TRANSACTIONS, LARGE_AMOUNT, INVALID_SIGNATURE, etc.
  description String
  metadata    Json?    // Additional context
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@map("suspicious_activity_log")
}

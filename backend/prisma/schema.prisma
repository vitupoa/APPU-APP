  @@index([resolved])
  @@index([severity])
  @@index([user_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model suspicious_activity_reports {
  id                   String    @id
  user_id              String
  activity_type        String
  description          String
  severity             String
  status               String    @default("DRAFT")
  filed_at             DateTime?
  filed_by             String?
  report_number        String?
  regulatory_body      String?
  related_transactions String[]  @default([])
  evidence_urls        String[]  @default([])
  metadata             Json?
  created_at           DateTime  @default(now())
  updated_at           DateTime

  @@index([activity_type], map: "idx_sar_activity_type")
  @@index([created_at], map: "idx_sar_created_at")
  @@index([filed_at], map: "idx_sar_filed_at")
  @@index([severity], map: "idx_sar_severity")
  @@index([status], map: "idx_sar_status")
  @@index([activity_type])
  @@index([created_at])
  @@index([filed_at])
  @@index([severity])
  @@index([status])
  @@index([user_id])
}

model team {
  id                         String                       @id
  name                       String                       @unique @db.VarChar(50)
  avatar_url                 String?
  leader_id                  String
  max_members                Int                          @default(5)
  total_wins                 Int                          @default(0)

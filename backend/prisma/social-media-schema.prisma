// ─── SOCIAL MEDIA SYNC LOG ────────────────────────────────

model SocialMediaSyncLog {
  id                String         @id @default(uuid())
  accountId         String         @map("account_id")
  
  // Sync Details
  syncType          String         @map("sync_type") // manual, scheduled, auto
  status            String         // success, failed, partial
  
  // Metrics Before/After
  followersBefore   Int            @map("followers_before")
  followersAfter    Int            @map("followers_after")
  followerChange    Int            @map("follower_change")
  
  // Error Handling
  errorMessage      String?        @map("error_message")
  errorCode         String?        @map("error_code")
  
  // Performance
  durationMs        Int            @map("duration_ms")
  
  syncedAt          DateTime       @default(now()) @map("synced_at")

  @@index([accountId, syncedAt])
  @@index([status])
  @@map("social_media_sync_logs")
}

// ─── PLATFORM RATE LIMITS ─────────────────────────────────

model PlatformRateLimit {
  id                String         @id @default(uuid())
  platform          SocialPlatform
  
  // Rate Limit Config
  requestsPerHour   Int            @map("requests_per_hour")
  requestsRemaining Int            @map("requests_remaining")
  resetAt           DateTime       @map("reset_at")
  
  // Tracking
  lastRequestAt     DateTime?      @map("last_request_at")
  
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@unique([platform])
  @@map("platform_rate_limits")
}

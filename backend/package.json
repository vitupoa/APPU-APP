{
  "name": "krieta-backend",
  "version": "1.0.0",
  "description": "Krieta Creator Marketing Engine — Backend API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc --noEmitOnError false && node -e \"import('fs').then(fs => { try { if (fs.existsSync('src/generated')) { fs.cpSync('src/generated', 'dist/generated', {recursive: true}); } } catch (err) { console.log('Skipping generated copy:', err.message); } })\"",
    "start": "node dist/index.js",
    "start:prod": "npm run migrate:rls && npm run start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seeds/seed-all.ts",
    "seed:admin": "tsx prisma/seeds/seed-super-admin.ts",
    "seed:niches": "tsx prisma/seeds/seed-niches.ts",
    "db:migrate:run": "tsx scripts/run-migrations.ts",
    "migrate:rls": "tsx migrate-rls-direct.ts",
    "test": "jest --coverage",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.35.3",
    "cloudinary": "^2.6.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.0.0",
    "html-escaper": "^3.0.3",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^2.36.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.6",
    "paystack-node": "^0.3.0",
    "pg": "^8.20.0",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.21.0",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/html-escaper": "^3.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.18",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "jest": "^30.3.0",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "babel-plugin-istanbul": "^7.0.1",
    "test-exclude": "^7.0.1",
    "uuid": "^14.0.0",
    "@hono/node-server": "^1.19.13",
    "@tootallnate/once": "^3.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

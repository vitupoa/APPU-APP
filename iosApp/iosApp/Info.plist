<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	
	<!-- Face ID / Touch ID Usage Description -->
	<key>NSFaceIDUsageDescription</key>
	<string>Runinga uses Face ID or Touch ID to securely authenticate withdrawals and protect your wallet.</string>
	
	<!-- Camera Permission (if needed for other features) -->
	<key>NSCameraUsageDescription</key>
	<string>Runinga needs camera access to capture photos and videos for posts.</string>
	
	<!-- Photo Library Permission -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Runinga needs access to your photo library to share photos and videos.</string>
	
	<!-- Location Permission (if needed) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Runinga uses your location to show nearby content and services.</string>
	
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.runinga.upload</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>fetch</string>
	</array>
</dict>
</plist>
